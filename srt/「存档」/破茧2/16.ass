Dialogue: 0,0:10:41.48,0:10:43.04,优酷剧集泰语,,0,0,0,,ถ้าผมจะให้คุณกลับไปทำโอที
Dialogue: 0,0:10:43.04,0:10:44.68,优酷剧集泰语,,0,0,0,,ตอนนี้เนี่ย คุณจะโกรธไหม
Dialogue: 0,0:10:45.60,0:10:46.80,优酷剧集泰语,,0,0,0,,ฉันกำลังโกรธอยู่เลย
Dialogue: 0,0:10:48.32,0:10:51.36,优酷剧集泰语,,0,0,0,,ที่โกรธเนี่ย เพราะว่าผมไม่ให้คุณกลับไปรับแฟนคุณเหรอ
Dialogue: 0,0:10:52.16,0:10:53.28,优酷剧集泰语,,0,0,0,,ฉันล้อเล่นน่ะ
Dialogue: 0,0:10:53.36,0:10:54.72,优酷剧集泰语,,0,0,0,,วรฤทธิ์ไปรับเขาแล้วค่ะ
Dialogue: 0,0:10:56.36,0:10:57.04,优酷剧集泰语,,0,0,0,,ขอโทษนะ
Dialogue: 0,0:10:58.28,0:11:00.80,优酷剧集泰语,,0,0,0,,แต่ว่าขึ้นศาลครั้งนี้ ผมต้องการให้คุณ
Dialogue: 0,0:11:01.48,0:11:03.84,优酷剧集泰语,,0,0,0,,ช่วยเหลือผมจริง ๆ ลำบากคุณแล้วนะ
Dialogue: 0,0:11:04.12,0:11:06.24,优酷剧集泰语,,0,0,0,,ไม่เป็นไรค่ะ งานต้องมาก่อน
Dialogue: 0,0:11:06.72,0:11:08.72,优酷剧集泰语,,0,0,0,,ในประเทศจีนก็เหมือนกันค่ะ
Dialogue: 0,0:11:09.36,0:11:11.12,优酷剧集泰语,,0,0,0,,แต่เพื่อเป็นการชดเชย
Dialogue: 0,0:11:11.52,0:11:13.48,优酷剧集泰语,,0,0,0,,ผมอนุญาตให้คุณหยุดพักสามวัน
Dialogue: 0,0:11:13.56,0:11:15.04,优酷剧集泰语,,0,0,0,,ไปเที่ยวกับแฟนของคุณได้
Dialogue: 0,0:11:15.72,0:11:17.36,优酷剧集泰语,,0,0,0,,คุณพูดจริงเหรอคะ
Dialogue: 0,0:11:17.72,0:11:18.80,优酷剧集泰语,,0,0,0,,ตอนนี้ก็ยังจริงอยู่
Dialogue: 0,0:11:20.36,0:11:21.56,优酷剧集泰语,,0,0,0,,งั้นฉันไปแล้วนะคะ
Dialogue: 0,0:11:22.04,0:11:24.72,优酷剧集泰语,,0,0,0,,เดี๋ยวสิ เดี๋ยวนะ คุณต้องไปส่งผมก่อนสิ
Dialogue: 0,0:11:24.84,0:11:26.36,优酷剧集泰语,,0,0,0,,ฉันกลัวคุณจะกลับคำทีหลังไงคะ
Dialogue: 0,0:11:33.24,0:11:34.72,优酷剧集泰语,,0,0,0,,ขอบคุณมากนะคะคุณหมอ
Dialogue: 0,0:11:35.40,0:11:37.72,优酷剧集泰语,,0,0,0,,ที่คุณช่วยเป็นพยานให้กับลูกชายของดิฉัน
Dialogue: 0,0:11:39.04,0:11:40.60,优酷剧集泰语,,0,0,0,,คุณช่วยเขาไว้แท้ ๆ
Dialogue: 0,0:11:41.56,0:11:43.84,优酷剧集泰语,,0,0,0,,ผมก็แค่พูดความจริงเท่านั้นเองครับ
Dialogue: 0,0:11:44.04,0:11:46.48,优酷剧集泰语,,0,0,0,,- ขอบคุณอีกครั้งนะคะ ขอบคุณค่ะ\N- ไม่เป็นไรครับ
Dialogue: 0,0:11:46.80,0:11:48.12,优酷剧集泰语,,0,0,0,,รายงานกับคำให้การของคุณ
Dialogue: 0,0:11:48.24,0:11:49.48,优酷剧集泰语,,0,0,0,,ผู้พิพากษาได้นำไปใช้แล้ว
Dialogue: 0,0:11:49.48,0:11:51.90,优酷剧集泰语,,0,0,0,,ทางศาลต้องขอให้อัยการตรวจสอบใหม่อีกครั้ง
Dialogue: 0,0:11:52.47,0:11:54.27,优酷剧集泰语,,0,0,0,,คิดไม่ถึงเลยว่านิติเวชกีฏวิทยาจะมหัศจรรย์ขนาดนี้
Dialogue: 0,0:11:54.28,0:11:55.48,优酷剧集泰语,,0,0,0,,ขอแลกนามบัตรด้วยได้ไหมครับ
Dialogue: 0,0:11:55.60,0:11:57.24,优酷剧集泰语,,0,0,0,,ต่อไปจะได้ขอความช่วยเหลือจากคุณได้ตลอด
Dialogue: 0,0:11:58.92,0:11:59.56,优酷剧集泰语,,0,0,0,,ตรงนี้ครับ
Dialogue: 0,0:12:03.56,0:12:05.04,优酷剧集泰语,,0,0,0,,น่าจะเป็นขาของผู้ชาย
Dialogue: 0,0:12:05.60,0:12:07.56,优酷剧集泰语,,0,0,0,,จินหลิงเป็นคนสังเกตเห็น ไม่น่าจะพลาด
Dialogue: 0,0:12:08.52,0:12:09.48,优酷剧集泰语,,0,0,0,,แต่ปัญหาคือ
Dialogue: 0,0:12:09.68,0:12:11.36,优酷剧集泰语,,0,0,0,,พวกเราจะเอารูปถ่ายใบนี้
Dialogue: 0,0:12:11.48,0:12:13.04,优酷剧集泰语,,0,0,0,,ไปเทียบกับคนทั้งกรุงเทพฯ
Dialogue: 0,0:12:13.04,0:12:14.48,优酷剧集泰语,,0,0,0,,ว่าเป็นขาของผู้ชายคนไหนไม่ได้หรอก
Dialogue: 0,0:12:14.68,0:12:17.68,优酷剧集泰语,,0,0,0,,แต่ว่าตอนนี้ก็มีแค่วิธีนี้วิธีเดียวนะครับ
Dialogue: 0,0:12:18.28,0:12:20.80,优酷剧集泰语,,0,0,0,,ภาพเปรียบเทียบรอยสักของสุพรรณออกมาแล้วยัง
Dialogue: 0,0:12:21.08,0:12:22.68,优酷剧集泰语,,0,0,0,,ยังไม่มีครับ ตอนนี้ยังไม่มี
Dialogue: 0,0:12:25.60,0:12:26.12,优酷剧集泰语,,0,0,0,,ฮัลโหล
Dialogue: 0,0:12:26.72,0:12:28.36,优酷剧集泰语,,0,0,0,,ฮัลโหล จิ่งเทียน นายอยู่ไหนน่ะ
Dialogue: 0,0:12:28.56,0:12:29.72,优酷剧集泰语,,0,0,0,,ฉันอยู่ที่สน.
Dialogue: 0,0:12:30.16,0:12:31.36,优酷剧集泰语,,0,0,0,,งั้นฉันก็สบายใจ
Dialogue: 0,0:12:31.48,0:12:33.16,优酷剧集泰语,,0,0,0,,มาริโอ้ให้ฉันหยุดสามวัน
Dialogue: 0,0:12:33.60,0:12:34.72,优酷剧集泰语,,0,0,0,,เราไปเที่ยวที่ไหนกันเถอะ
Dialogue: 0,0:12:35.24,0:12:36.36,优酷剧集泰语,,0,0,0,,จริงเหรอ เยี่ยมไปเลย
Dialogue: 0,0:12:36.56,0:12:38.40,优酷剧集泰语,,0,0,0,,งั้นนายอยากไปไหน เราออกเดินทางกันเดี๋ยวนี้เลย
Dialogue: 0,0:12:38.68,0:12:39.84,优酷剧集泰语,,0,0,0,,เดินทางเดี๋ยวนี้เลยเหรอ
Dialogue: 0,0:12:40.16,0:12:42.04,优酷剧集泰语,,0,0,0,,ใช่ ฉันกลัวมาริโอ้เปลี่ยนใจ
Dialogue: 0,0:12:42.12,0:12:44.16,优酷剧集泰语,,0,0,0,,อีกอย่างทางที่ดีเราไปที่ไกล ๆ หน่อย
Dialogue: 0,0:12:44.28,0:12:45.72,优酷剧集泰语,,0,0,0,,ฉันกลัวว่าวันมะรืนเขาก็เปลี่ยนใจแล้ว
Dialogue: 0,0:12:45.92,0:12:48.56,优酷剧集泰语,,0,0,0,,ไปที่ไกลหน่อยงั้นเหรอ
Dialogue: 0,0:12:49.16,0:12:49.80,优酷剧集泰语,,0,0,0,,มีเรื่องอะไร
Dialogue: 0,0:12:50.28,0:12:52.80,优酷剧集泰语,,0,0,0,,จินหลิงบอกว่ามาริโอ้ให้เธอหยุดสามวัน
Dialogue: 0,0:12:53.80,0:12:54.72,优酷剧集泰语,,0,0,0,,จะเป็นไปได้ยังไง
Dialogue: 0,0:12:55.28,0:12:57.52,优酷剧集泰语,,0,0,0,,ในภาพจำของฉัน หมอนั่นชอบให้จินหลิง
Dialogue: 0,0:12:57.52,0:12:58.72,优酷剧集泰语,,0,0,0,,ทำโอทีทุกคืนไม่ใช่เหรอ
Dialogue: 0,0:12:58.92,0:12:59.92,优酷剧集泰语,,0,0,0,,เมื่อกี้จินหลิงบอกมาน่ะ
Dialogue: 0,0:13:01.28,0:13:02.68,优酷剧集泰语,,0,0,0,,อันนี้ภาษาจีนเขาพูดว่ายังไงนะ
Dialogue: 0,0:13:03.40,0:13:04.94,优酷剧集泰语,,0,0,0,,สงสัยพระอาทิตย์ขึ้นทางตะวันตกแน่ ๆ เลย
Dialogue: 0,0:13:05.28,0:13:08.16,优酷剧集泰语,,0,0,0,,จินหลิงบอกว่าจะไปที่ไกล ๆ หน่อย
Dialogue: 0,0:13:08.16,0:13:09.68,优酷剧集泰语,,0,0,0,,เผื่อมาริโอ้เปลี่ยนใจกะทันหัน
Dialogue: 0,0:13:09.96,0:13:11.72,优酷剧集泰语,,0,0,0,,ที่ไกล ๆ หน่อยงั้นเหรอ
Dialogue: 0,0:13:14.60,0:13:17.36,优酷剧集泰语,,0,0,0,,อย่าบอกนะว่าจินหลิงคิดจะเปลี่ยนวิธีนัดนาย
Dialogue: 0,0:13:20.84,0:13:23.92,优酷剧集泰语,,0,0,0,,คนเขาเป็นแฟนกันนัดกันไปเที่ยวก็...\Nนัดกันไปเที่ยวก็ปกติป๊ะ
Dialogue: 0,0:13:25.36,0:13:26.84,优酷剧集泰语,,0,0,0,,เร็ว ๆ หน่อย คิดได้หรือยัง
Dialogue: 0,0:13:27.16,0:13:27.92,优酷剧集泰语,,0,0,0,,ได้ รอเดี๋ยว ๆ
Dialogue: 0,0:13:27.92,0:13:28.60,优酷剧集泰语,,0,0,0,,ฉันถามพวกเขาอยู่
Dialogue: 0,0:13:28.84,0:13:29.92,优酷剧集泰语,,0,0,0,,เร็วหน่อย ๆ ไปที่ไหนดี
Dialogue: 0,0:13:30.24,0:13:30.72,优酷剧集泰语,,0,0,0,,ฉันคิดก่อนนะ
Dialogue: 0,0:13:33.40,0:13:36.04,优酷剧集泰语,,0,0,0,,พัทยา สมุย ภูเก็ต เชียงใหม่
Dialogue: 0,0:13:36.68,0:13:38.84,优酷剧集泰语,,0,0,0,,ผมว่าคนส่วนใหญ่เขาไปที่พวกนี้กันนะครับ
Dialogue: 0,0:13:39.28,0:13:40.36,优酷剧集泰语,,0,0,0,,เชยมาก
Dialogue: 0,0:13:40.72,0:13:42.36,优酷剧集泰语,,0,0,0,,ไม่ได้ เชยเกิน ๆ
Dialogue: 0,0:13:42.48,0:13:45.04,优酷剧集泰语,,0,0,0,,ใช่ ฉันจำได้ว่าถังต้าเต๋อเคยบอกว่า
Dialogue: 0,0:13:45.16,0:13:48.04,优酷剧集泰语,,0,0,0,,ทางภาคเหนือมีเขตอนุรักษ์ธรรมชาติอยู่แห่งหนึ่ง
Dialogue: 0,0:13:48.16,0:13:50.72,优酷剧集泰语,,0,0,0,,เห็นบอกว่าข้างในมีผีเสื้อสี่ร้อยกว่าชนิดเลย
Dialogue: 0,0:13:51.36,0:13:52.12,优酷剧集泰语,,0,0,0,,ฉันคิดก่อนนะ
Dialogue: 0,0:13:52.80,0:13:55.16,优酷剧集泰语,,0,0,0,,ปางสีดา ปางสีดาไง
Dialogue: 0,0:13:55.68,0:13:56.68,优酷剧集泰语,,0,0,0,,เขตอนุรักษ์ธรรมชาติ
Dialogue: 0,0:13:57.24,0:13:59.48,优酷剧集泰语,,0,0,0,,ที่นั่นใกล้บ้านเกิดฉันมากเลยนะ
Dialogue: 0,0:14:00.16,0:14:01.36,优酷剧集泰语,,0,0,0,,ไอเดียนี้ดีมาก
Dialogue: 0,0:14:01.48,0:14:03.48,优酷剧集泰语,,0,0,0,,ที่นั่นมีรีสอร์ตด้วย สวยสุด ๆ
Dialogue: 0,0:14:03.48,0:14:04.68,优酷剧集泰语,,0,0,0,,โอเคนะ ๆ
Dialogue: 0,0:14:06.28,0:14:08.28,优酷剧集泰语,,0,0,0,,ฮัลโหล เธอได้ยินแล้วใช่ไหม เธอคิดว่าโอเคหรือเปล่า
Dialogue: 0,0:14:08.36,0:14:10.72,优酷剧集泰语,,0,0,0,,ขอแค่ออกจากกรุงเทพฯ จะไปที่ไหนก็ได้
Dialogue: 0,0:14:10.80,0:14:12.40,优酷剧集泰语,,0,0,0,,งั้นตอนนี้ฉันจะกลับไปเก็บกระเป๋า
Dialogue: 0,0:14:12.40,0:14:13.48,优酷剧集泰语,,0,0,0,,จากนั้นไปรับนายนะ
Dialogue: 0,0:14:13.60,0:14:14.60,优酷剧集泰语,,0,0,0,,แค่นี้นะ บ๊ายบาย
Dialogue: 0,0:14:19.24,0:14:20.72,优酷剧集泰语,,0,0,0,,บ้านพี่ไม่ได้อยู่ทางภาคใต้เหรอ
Dialogue: 0,0:14:21.12,0:14:22.72,优酷剧集泰语,,0,0,0,,พ่อพี่อยู่ทางภาคใต้ไง
Dialogue: 0,0:14:22.84,0:14:24.36,优酷剧集泰语,,0,0,0,,แต่แม่พี่ก็อยู่...
Dialogue: 0,0:14:25.60,0:14:26.60,优酷剧集泰语,,0,0,0,,ฉันไปส่งพวกนายดีกว่า
Dialogue: 0,0:14:27.24,0:14:29.16,优酷剧集泰语,,0,0,0,,ตรงนั้นอยู่ติดชายแดน ถนนเดินทางยาก
Dialogue: 0,0:14:30.60,0:14:34.92,优酷剧集泰语,,0,0,0,,สิบกว่าชั่วโมง เดินทางไปกลับ\Nไม่ลำบากแย่เลยเหรอครับ
Dialogue: 0,0:14:37.12,0:14:40.16,优酷剧集泰语,,0,0,0,,ก็ถ้า...ก็อยู่ค้างสักคืนไง ไม่เห็นเป็นไรเลย
Dialogue: 0,0:14:40.80,0:14:43.28,优酷剧集泰语,,0,0,0,,คนเขาอุตส่าห์มีเวลาไปเที่ยวด้วยกัน
Dialogue: 0,0:14:43.28,0:14:45.68,优酷剧集泰语,,0,0,0,,ก็...ยังจะไปกวนเขาอีกเนอะ
Dialogue: 0,0:14:46.72,0:14:48.60,优酷剧集泰语,,0,0,0,,เดินทางสิบกว่าชั่วโมงเลยเหรอ
Dialogue: 0,0:14:48.72,0:14:49.60,优酷剧集泰语,,0,0,0,,มันไกลเกินไปไหม
Dialogue: 0,0:14:49.60,0:14:50.36,优酷剧集泰语,,0,0,0,,พวกเราเปลี่ยนที่ดีกว่า
Dialogue: 0,0:14:50.36,0:14:52.24,优酷剧集泰语,,0,0,0,,ไม่ไกลเลย แค่สิบกว่าชั่วโมงเอง
Dialogue: 0,0:14:52.24,0:14:54.48,优酷剧集泰语,,0,0,0,,ที่นั่นควรค่าให้ไปดูสักหน่อยนะ
Dialogue: 0,0:14:54.56,0:14:54.92,优酷剧集泰语,,0,0,0,,ฉันจะบอกนายให้
Dialogue: 0,0:14:54.92,0:14:56.04,优酷剧集泰语,,0,0,0,,ตอนที่พวกเราขับรถไปนะ
Dialogue: 0,0:14:56.04,0:14:58.16,优酷剧集泰语,,0,0,0,,วิวทั้งสองข้างสวยสุด ๆ ไปเลย
Dialogue: 0,0:14:58.16,0:14:59.04,优酷剧集泰语,,0,0,0,,สวยมาก
Dialogue: 0,0:14:59.04,0:14:59.96,优酷剧集泰语,,0,0,0,,แต่ถนนขับยากมาก
Dialogue: 0,0:14:59.96,0:15:02.04,优酷剧集泰语,,0,0,0,,ถ้าพวกนายไปเองจะต้องขับช้ามากชัวร์ ๆ
Dialogue: 0,0:15:02.12,0:15:04.40,优酷剧集泰语,,0,0,0,,ต้องให้ฉันพาพวกนายไปสิ ปลอดภัยกว่า เร็วกว่า
Dialogue: 0,0:15:06.16,0:15:07.04,优酷剧集泰语,,0,0,0,,งั้นผมไปเป็นเพื่อนพี่
Dialogue: 0,0:15:07.04,0:15:08.96,优酷剧集泰语,,0,0,0,,ไม่ต้อง ไปทำไม
Dialogue: 0,0:15:09.04,0:15:10.28,优酷剧集泰语,,0,0,0,,พี่จะได้ไม่ต้องไปคนเดียวไง
Dialogue: 0,0:15:11.08,0:15:13.48,优酷剧集泰语,,0,0,0,,แล้วงานที่นี่ล่ะ ใครเขาจะทำกัน
