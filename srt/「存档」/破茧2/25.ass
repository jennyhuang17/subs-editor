Dialogue: 0,0:00:11.98,0:00:14.94,优酷剧集泰语,,0,0,0,,[เรื่องนี้เป็นเพียงเรื่องสมมติเท่านั้น]
Dialogue: 0,0:00:15.46,0:00:18.22,优酷剧集泰语,,0,0,0,,[โครงเรื่องและตัวละครหลักไม่มีต้นแบบในความเป็นจริง]
Dialogue: 0,0:02:30.06,0:02:34.62,优酷剧集泰语,,0,0,0,,[ทลายรังไหม ซีซัน 2]
Dialogue: 0,0:02:34.62,0:02:37.10,优酷剧集泰语,,0,0,0,,[ตอนที่ 25]
Dialogue: 0,0:02:38.62,0:02:45.46,优酷剧集泰语,,0,0,0,,ทำไมเป็นอย่างงี้อะ ผมชอบเขามากเลยนะเว้ยพี่\Nเพราะเขาเล่น ผมเลยดูโขน
Dialogue: 0,0:02:46.72,0:02:50.32,优酷剧集泰语,,0,0,0,,ละครโขนน่ะ\Nนี่ถ้าไม่มีเขาผมก็ไม่เคยดูเลยนะละครโขนน่ะ
Dialogue: 0,0:02:52.64,0:02:55.52,优酷剧集泰语,,0,0,0,,ปีที่แล้วยังเล่นเป็นพระรามอยู่เลย ดูปีนี้ดิ
Dialogue: 0,0:02:57.48,0:03:00.24,优酷剧集泰语,,0,0,0,,ทำไมอยู่ดี ๆ มาตายกลางแจ้งที่รกร้างแบบนี้
Dialogue: 0,0:03:02.60,0:03:07.08,优酷剧集泰语,,0,0,0,,อีกอย่าง ตายเพราะยาเสพติดด้วย
Dialogue: 0,0:03:09.40,0:03:12.52,优酷剧集泰语,,0,0,0,,คนเรานี่เหมือนดาวตกเลยเนอะพี่
Dialogue: 0,0:03:13.12,0:03:14.36,优酷剧集泰语,,0,0,0,,มาแป๊บ ๆ แล้วก็ไป
Dialogue: 0,0:03:16.16,0:03:17.60,优酷剧集泰语,,0,0,0,,ชีวิตคนเรามันไม่แน่นอนเลยเนอะ
Dialogue: 0,0:03:19.20,0:03:20.24,优酷剧集泰语,,0,0,0,,นี่มึงเข้าเรื่องได้หรือยัง
Dialogue: 0,0:03:23.56,0:03:25.44,优酷剧集泰语,,0,0,0,,มิน่าหลายครั้งกลับบ้านดึก ๆ
Dialogue: 0,0:03:25.56,0:03:26.76,优酷剧集泰语,,0,0,0,,ถึงได้กลัวยังไงชอบกล
Dialogue: 0,0:03:27.00,0:03:28.48,优酷剧集泰语,,0,0,0,,มักรู้สึกเหมือนมีใครสะกดรอยตาม
Dialogue: 0,0:03:29.38,0:03:30.36,优酷剧集泰语,,0,0,0,,ที่แท้ก็เป็นของจริง
Dialogue: 0,0:03:30.68,0:03:32.64,优酷剧集泰语,,0,0,0,,เรื่องนี้ฉันเป็นพยานให้จินหลิงได้
Dialogue: 0,0:03:33.08,0:03:33.86,优酷剧集泰语,,0,0,0,,มีครั้งนึงที่เธอ
Dialogue: 0,0:03:33.86,0:03:35.72,优酷剧集泰语,,0,0,0,,เข้าใจผิดว่าฉันเป็นคนที่คอยสะกดรอยตามเธอ
Dialogue: 0,0:03:37.00,0:03:38.00,优酷剧集泰语,,0,0,0,,แค่สะกดรอยตามเหรอ
Dialogue: 0,0:03:38.96,0:03:40.08,优酷剧集泰语,,0,0,0,,มีทำอย่างอื่นบ้างไหม
Dialogue: 0,0:03:40.24,0:03:41.04,优酷剧集泰语,,0,0,0,,ไม่มีนะ
Dialogue: 0,0:03:41.68,0:03:43.36,优酷剧集泰语,,0,0,0,,ไม่งั้นฉันไม่มีทางไม่รู้หรอก
Dialogue: 0,0:03:44.00,0:03:45.24,优酷剧集泰语,,0,0,0,,เริ่มตั้งแต่เมื่อไรเหรอ
Dialogue: 0,0:03:45.92,0:03:48.36,优酷剧集泰语,,0,0,0,,เริ่มตั้งแต่จิ่งเทียนกลับจีนได้ไม่นาน
Dialogue: 0,0:03:49.12,0:03:50.96,优酷剧集泰语,,0,0,0,,ปัญหาคือเขาสะกดรอยตามฉันทำไม
Dialogue: 0,0:03:51.88,0:03:52.64,优酷剧集泰语,,0,0,0,,เรื่องนี้คุณไม่รู้
Dialogue: 0,0:03:52.64,0:03:53.88,优酷剧集泰语,,0,0,0,,พวกผมก็ไม่รู้เหมือนกัน
Dialogue: 0,0:03:54.44,0:03:54.96,优酷剧集泰语,,0,0,0,,หรือว่า
Dialogue: 0,0:03:56.76,0:03:57.68,优酷剧集泰语,,0,0,0,,เขาจะชอบคุณ
Dialogue: 0,0:03:58.76,0:04:02.04,优酷剧集泰语,,0,0,0,,แล้วก็คงเป็นไปได้อีกอย่างก็คือ\Nเขาอาจจะคิดอะไรไม่บริสุทธิ์กับคุณหรือเปล่า
Dialogue: 0,0:04:02.52,0:04:04.40,优酷剧集泰语,,0,0,0,,คุณพูดแบบนี้มันเริ่มจะไม่มีเหตุผลแล้วนะ
Dialogue: 0,0:04:04.80,0:04:06.12,优酷剧集泰语,,0,0,0,,แต่มันก็ไม่ใช่ว่าเป็นไปไม่ได้นะครับ
Dialogue: 0,0:04:06.44,0:04:11.56,优酷剧集泰语,,0,0,0,,พีรวัสเองก็เป็นศิลปิน ดังนั้นการที่เขาจะรักใครสักคน\Nหรือว่าตกหลุมรักใคร หรือว่าใจง่ายกับใครสักคน
Dialogue: 0,0:04:12.08,0:04:13.60,优酷剧集泰语,,0,0,0,,มันก็ไม่ใช่เรื่องที่เป็นไปไม่ได้นะครับ
Dialogue: 0,0:04:20.48,0:04:21.48,优酷剧集泰语,,0,0,0,,สะกดรอยตามจินหลิง
Dialogue: 0,0:04:21.84,0:04:22.76,优酷剧集泰语,,0,0,0,,สะกดรอยตามรัญญา
Dialogue: 0,0:04:23.48,0:04:24.84,优酷剧集泰语,,0,0,0,,พวกเขาสองคนเป็นผู้หญิงทั้งคู่
Dialogue: 0,0:04:25.00,0:04:26.12,优酷剧集泰语,,0,0,0,,เรื่องนี้ยังอธิบายได้
Dialogue: 0,0:04:26.68,0:04:28.24,优酷剧集泰语,,0,0,0,,แต่สะกดรอยตามมาริโอ้
Dialogue: 0,0:04:29.12,0:04:30.32,优酷剧集泰语,,0,0,0,,เพราะอะไรอีกล่ะ
Dialogue: 0,0:04:30.76,0:04:33.04,优酷剧集泰语,,0,0,0,,แถมเขากับมาริโอ้ก็ขัดแย้งกันด้วย
Dialogue: 0,0:04:33.84,0:04:35.20,优酷剧集泰语,,0,0,0,,แถมไม่ใช่ความขัดแย้งธรรมดา
Dialogue: 0,0:04:35.68,0:04:37.04,优酷剧集泰语,,0,0,0,,ตอนพีรวัสตาย
Dialogue: 0,0:04:37.20,0:04:39.12,优酷剧集泰语,,0,0,0,,ในมือยังกุมกระดุมของมาริโอ้อยู่เลย
Dialogue: 0,0:04:42.84,0:04:43.64,优酷剧集泰语,,0,0,0,,หรือว่า
Dialogue: 0,0:04:45.99,0:04:48.60,优酷剧集泰语,,0,0,0,,หรือว่ามาริโอ้จะเป็นคนฆ่าพีรวัส
Dialogue: 0,0:04:50.68,0:04:51.68,优酷剧集泰语,,0,0,0,,จะเป็นไปได้ยังไง
Dialogue: 0,0:04:51.68,0:04:52.76,优酷剧集泰语,,0,0,0,,เขาทำเพื่ออะไรล่ะ
Dialogue: 0,0:04:53.24,0:04:54.68,优酷剧集泰语,,0,0,0,,ทำไมมาริโอ้ต้องเกิดความขัดแย้ง
Dialogue: 0,0:04:54.68,0:04:55.48,优酷剧集泰语,,0,0,0,,กับพีรวัสด้วยล่ะ
Dialogue: 0,0:04:56.00,0:04:57.68,优酷剧集泰语,,0,0,0,,ต่อให้ขัดแย้งกันก็ต้องถึงกับฆ่าคนเลยเหรอ
Dialogue: 0,0:04:58.04,0:04:59.40,优酷剧集泰语,,0,0,0,,เป็นถึงคุณหมอนิติเวช
Dialogue: 0,0:04:59.60,0:05:00.68,优酷剧集泰语,,0,0,0,,ฆ่าคนเร่ร่อนคนเดียวเนี่ยนะ
Dialogue: 0,0:05:02.04,0:05:02.76,优酷剧集泰语,,0,0,0,,ขอโทษค่ะ
Dialogue: 0,0:05:03.04,0:05:04.88,优酷剧集泰语,,0,0,0,,ฉันไม่ได้จะดูถูกคนเร่ร่อนนะคะ
Dialogue: 0,0:05:05.48,0:05:07.24,优酷剧集泰语,,0,0,0,,แต่ว่ามันไม่สมเหตุสมผลจริง ๆ
Dialogue: 0,0:05:09.48,0:05:12.76,优酷剧集泰语,,0,0,0,,อาจจะเป็นเพราะว่า เป็นไปได้ที่มาริโอ้จะชอบคุณ
Dialogue: 0,0:05:13.64,0:05:15.80,优酷剧集泰语,,0,0,0,,แล้วพอเห็นพีรวัสเดินตามคุณ
Dialogue: 0,0:05:16.04,0:05:18.60,优酷剧集泰语,,0,0,0,,เขาก็เลยกลัวว่าพีรวัสอาจจะทำอะไรไม่ดีกับคุณ
Dialogue: 0,0:05:18.60,0:05:20.08,优酷剧集泰语,,0,0,0,,หรือว่าทำอะไรอันตรายใส่คุณหรือเปล่า
Dialogue: 0,0:05:20.20,0:05:23.80,优酷剧集泰语,,0,0,0,,เขาก็เลยทะเลาะกัน\Nพอทะเลาะกันเสร็จ ทะเลาะกันจนถึง
Dialogue: 0,0:05:24.76,0:05:25.60,优酷剧集泰语,,0,0,0,,ขั้นฆ่ากันตาย
Dialogue: 0,0:05:26.76,0:05:28.88,优酷剧集泰语,,0,0,0,,มันสมองอย่างคุณเข้ามาเป็นตำรวจได้ยังไงคะ
Dialogue: 0,0:05:30.24,0:05:32.96,优酷剧集泰语,,0,0,0,,ถึงแม้ว่าผมจะทำคดีไม่ได้แม่นยำขนาดนั้นหรือว่า
Dialogue: 0,0:05:33.20,0:05:34.68,优酷剧集泰语,,0,0,0,,อาจจะไม่ได้โปรเฟสชั่นแนลขนาดนั้น
Dialogue: 0,0:05:35.20,0:05:37.68,优酷剧集泰语,,0,0,0,,แต่ว่าผมบอกเลยนะว่าเรื่องพวกนี้ ผมแม่นมาก
Dialogue: 0,0:05:38.16,0:05:40.88,优酷剧集泰语,,0,0,0,,และผมบอกเลยว่ามาริโอ้ชอบคุณ
Dialogue: 0,0:05:41.12,0:05:42.12,优酷剧集泰语,,0,0,0,,ร้อยเปอร์เซ็นต์
Dialogue: 0,0:05:42.22,0:05:43.14,优酷剧集泰语,,0,0,0,,นี่
Dialogue: 0,0:05:43.60,0:05:44.76,优酷剧集泰语,,0,0,0,,มีอะไรน่าแปลกกัน
Dialogue: 0,0:05:46.24,0:05:47.68,优酷剧集泰语,,0,0,0,,ดูออกตั้งนานแล้ว
Dialogue: 0,0:05:49.32,0:05:50.20,优酷剧集泰语,,0,0,0,,อีกอย่าง
Dialogue: 0,0:05:50.52,0:05:51.96,优酷剧集泰语,,0,0,0,,จะชอบจินหลิงก็ไม่ใช่เรื่องน่าแปลกเลย
Dialogue: 0,0:05:52.24,0:05:53.04,优酷剧集泰语,,0,0,0,,คุณไม่ชอบเหรอ
Dialogue: 0,0:05:55.88,0:05:56.60,优酷剧集泰语,,0,0,0,,ชอบครับ
Dialogue: 0,0:05:56.84,0:05:57.48,优酷剧集泰语,,0,0,0,,ขอบคุณ
Dialogue: 0,0:05:59.76,0:06:00.88,优酷剧集泰语,,0,0,0,,พูดจริง ๆ นะ
Dialogue: 0,0:06:01.60,0:06:03.96,优酷剧集泰语,,0,0,0,,ผมรู้สึกว่าระหว่างพวกเขา
Dialogue: 0,0:06:04.48,0:06:06.56,优酷剧集泰语,,0,0,0,,การทะเลาะกันไม่ใช่ธรรมดา ๆ
Dialogue: 0,0:06:07.20,0:06:08.92,优酷剧集泰语,,0,0,0,,คุณไม่เห็นวิดีโอในวงจรปิดเหรอ
Dialogue: 0,0:06:09.20,0:06:11.68,优酷剧集泰语,,0,0,0,,พีรวัสถึงกับใช้มีดกับมาริโอ้เลยนะ
Dialogue: 0,0:06:12.24,0:06:13.76,优酷剧集泰语,,0,0,0,,พีรวัสใช้มีดกับมาริโอ้
Dialogue: 0,0:06:13.76,0:06:15.36,优酷剧集泰语,,0,0,0,,ไม่ได้หมายความว่ามาริโอ้ก็ต้องใช้มีด
Dialogue: 0,0:06:15.36,0:06:15.92,优酷剧集泰语,,0,0,0,,กับพีรวัส
Dialogue: 0,0:06:15.92,0:06:16.80,优酷剧集泰语,,0,0,0,,หรือฆ่าคนนะ
Dialogue: 0,0:06:17.08,0:06:18.08,优酷剧集泰语,,0,0,0,,เขาสามารถแจ้งความ
Dialogue: 0,0:06:18.08,0:06:19.20,优酷剧集泰语,,0,0,0,,ควบคุมตัวพีรวัสก็ได้
Dialogue: 0,0:06:19.52,0:06:20.88,优酷剧集泰语,,0,0,0,,นี่แหละปัญหา
Dialogue: 0,0:06:21.76,0:06:23.68,优酷剧集泰语,,0,0,0,,ทำไมมาริโอ้ไม่แจ้งความล่ะ
Dialogue: 0,0:06:28.04,0:06:28.96,优酷剧集泰语,,0,0,0,,ไม่ทันได้แจ้ง
Dialogue: 0,0:06:30.08,0:06:31.12,优酷剧集泰语,,0,0,0,,เหตุการณ์บังเอิญ
Dialogue: 0,0:06:31.80,0:06:33.04,优酷剧集泰语,,0,0,0,,หรืออาจจะเป็นเรื่องเข้าใจผิด
Dialogue: 0,0:06:34.12,0:06:35.24,优酷剧集泰语,,0,0,0,,ไม่ต้องถึงขั้นแจ้งความมั้ง
Dialogue: 0,0:06:47.60,0:06:48.20,优酷剧集泰语,,0,0,0,,ใช่ครับ
Dialogue: 0,0:06:49.36,0:06:50.56,优酷剧集泰语,,0,0,0,,ผมมีอย่างหนึ่งลืมบอก
Dialogue: 0,0:06:52.64,0:06:56.60,优酷剧集泰语,,0,0,0,,มีผู้ชายหน้าตาใช้ได้คนหนึ่ง เอารูปพีรวัส
Dialogue: 0,0:06:57.52,0:07:01.08,优酷剧集泰语,,0,0,0,,ไปหาคนเร่ร่อนที่ชายเมืองทางภาคใต้ครับผม\Nแล้วก็ไปถามเขาว่าคือใคร
Dialogue: 0,0:07:02.52,0:07:05.08,优酷剧集泰语,,0,0,0,,ซึ่งรูปภาพนั้นน่ะครับ เป็นภาพวาด
Dialogue: 0,0:07:05.36,0:07:06.80,优酷剧集泰语,,0,0,0,,ไม่ใช่รูปภาพที่เป็นภาพถ่าย
Dialogue: 0,0:07:09.52,0:07:11.64,优酷剧集泰语,,0,0,0,,นี่คุยมาตั้งนาน ทำไมมึงเพิ่งพูดเนี่ย
Dialogue: 0,0:07:13.83,0:07:14.72,优酷剧集泰语,,0,0,0,,นี่หันไปเลย
Dialogue: 0,0:07:15.92,0:07:16.56,优酷剧集泰语,,0,0,0,,หันไปเลย
Dialogue: 0,0:07:17.56,0:07:18.48,优酷剧集泰语,,0,0,0,,หันไป
Dialogue: 0,0:07:20.04,0:07:20.40,优酷剧集泰语,,0,0,0,,ครับ
Dialogue: 0,0:07:20.60,0:07:25.64,优酷剧集泰语,,0,0,0,,ถ้านึกอะไรออกมาเนี่ย ค่อยหันมาพูดนะ\Nแต่ถ้าไม่ได้รับการอนุญาตของผม อย่าพูด
Dialogue: 0,0:07:26.24,0:07:27.40,优酷剧集泰语,,0,0,0,,งั้นเราไปถามมาริโอ้ดีไหมครับ
Dialogue: 0,0:07:30.48,0:07:31.64,优酷剧集泰语,,0,0,0,,มันไม่ดีมั้ง
Dialogue: 0,0:07:32.12,0:07:34.24,优酷剧集泰语,,0,0,0,,ผมว่าเราก็เป็นระบบเดียวกัน
Dialogue: 0,0:07:34.64,0:07:36.64,优酷剧集泰语,,0,0,0,,ตอนนี้ก็ยังพึ่งพาเขาอยู่
Dialogue: 0,0:07:36.88,0:07:38.88,优酷剧集泰语,,0,0,0,,ละก็ไม่งั้น อายกันใหญ่เลยนะ
