Dialogue: 0,0:01:33.16,0:01:35.91,优酷剧集英语,,0,0,0,,您是把他俩
Dialogue: 0,0:01:42.08,0:01:43.55,优酷剧集英语,,0,0,0,,你觉得那两口子
Dialogue: 0,0:01:44.40,0:01:45.16,优酷剧集英语,,0,0,0,,怎么样
Dialogue: 0,0:01:45.80,0:01:47.36,优酷剧集英语,,0,0,0,,他们两口子
Dialogue: 0,0:01:48.40,0:01:49.68,优酷剧集英语,,0,0,0,,两个普通人
Dialogue: 0,0:01:50.16,0:01:51.44,优酷剧集英语,,0,0,0,,遇上事了
Dialogue: 0,0:01:53.00,0:01:54.08,优酷剧集英语,,0,0,0,,瓦子里边
Dialogue: 0,0:01:55.27,0:01:58.12,优酷剧集英语,,0,0,0,,能在咱们俩眼皮子底下脱身
Dialogue: 0,0:01:59.95,0:02:01.16,优酷剧集英语,,0,0,0,,梅船的时候
Dialogue: 0,0:02:01.87,0:02:03.87,优酷剧集英语,,0,0,0,,能帮着咱们拿人
Dialogue: 0,0:02:06.31,0:02:07.12,优酷剧集英语,,0,0,0,,明白
Dialogue: 0,0:02:07.91,0:02:09.72,优酷剧集英语,,0,0,0,,经开封府衙查办
Dialogue: 0,0:02:09.80,0:02:11.88,优酷剧集英语,,0,0,0,,贼寇匪首萧逸水归案
Dialogue: 0,0:02:12.11,0:02:15.60,优酷剧集英语,,0,0,0,,城东平民赵某对缉凶亦有贡献
Dialogue: 0,0:02:16.16,0:02:17.36,优酷剧集英语,,0,0,0,,贼寇凶暴
Dialogue: 0,0:02:17.39,0:02:18.36,优酷剧集英语,,0,0,0,,滥杀无辜
Dialogue: 0,0:02:18.36,0:02:19.32,优酷剧集英语,,0,0,0,,罪大恶极
Dialogue: 0,0:02:19.32,0:02:20.27,优酷剧集英语,,0,0,0,,天理不容
Dialogue: 0,0:02:20.32,0:02:21.75,优酷剧集英语,,0,0,0,,依大宋刑律
Dialogue: 0,0:02:22.00,0:02:23.27,优酷剧集英语,,0,0,0,,必受严惩
Dialogue: 0,0:02:24.08,0:02:26.55,优酷剧集英语,,0,0,0,,城内居民各仰归业
Dialogue: 0,0:02:27.11,0:02:28.32,优酷剧集英语,,0,0,0,,无使惊扰
Dialogue: 0,0:02:30.52,0:02:31.32,优酷剧集英语,,0,0,0,,大哥啊
Dialogue: 0,0:02:31.75,0:02:32.55,优酷剧集英语,,0,0,0,,大哥 大哥
Dialogue: 0,0:02:32.55,0:02:33.72,优酷剧集英语,,0,0,0,,我问一下啊
Dialogue: 0,0:02:34.32,0:02:36.16,优酷剧集英语,,0,0,0,,城东居民赵某
Dialogue: 0,0:02:36.80,0:02:38.16,优酷剧集英语,,0,0,0,,他叫赵什么呀
Dialogue: 0,0:02:38.72,0:02:39.91,优酷剧集英语,,0,0,0,,这个我知道
Dialogue: 0,0:02:40.32,0:02:41.24,优酷剧集英语,,0,0,0,,这个赵某呀
Dialogue: 0,0:02:41.24,0:02:42.67,优酷剧集英语,,0,0,0,,她是个女的
Dialogue: 0,0:02:42.67,0:02:43.60,优酷剧集英语,,0,0,0,,女的
Dialogue: 0,0:02:43.60,0:02:44.72,优酷剧集英语,,0,0,0,,还是个老太太
Dialogue: 0,0:02:44.72,0:02:46.08,优酷剧集英语,,0,0,0,,老太太呀
Dialogue: 0,0:02:50.83,0:02:51.96,优酷剧集英语,,0,0,0,,我们头儿找你
Dialogue: 0,0:03:10.27,0:03:11.96,优酷剧集英语,,0,0,0,,你虽然在大理寺任职
Dialogue: 0,0:03:13.16,0:03:13.96,优酷剧集英语,,0,0,0,,懂规矩
Dialogue: 0,0:03:16.11,0:03:18.47,优酷剧集英语,,0,0,0,,但我们开封府的规矩啊更多
Dialogue: 0,0:03:19.60,0:03:20.39,优酷剧集英语,,0,0,0,,小心点
Dialogue: 0,0:03:30.08,0:03:32.96,优酷剧集英语,,0,0,0,,那上面都是我们历代府尹的名讳
Dialogue: 0,0:03:36.24,0:03:36.96,优酷剧集英语,,0,0,0,,别瞎摸
Dialogue: 0,0:03:39.11,0:03:39.88,优酷剧集英语,,0,0,0,,得敬
Dialogue: 0,0:03:55.16,0:03:56.19,优酷剧集英语,,0,0,0,,眼睛挺尖
Dialogue: 0,0:04:06.88,0:04:07.52,优酷剧集英语,,0,0,0,,万推司
Dialogue: 0,0:04:08.80,0:04:09.39,优酷剧集英语,,0,0,0,,来啊
Dialogue: 0,0:04:10.03,0:04:10.80,优酷剧集英语,,0,0,0,,来 过来
Dialogue: 0,0:04:15.60,0:04:16.51,优酷剧集英语,,0,0,0,,告示看了
Dialogue: 0,0:04:16.88,0:04:17.92,优酷剧集英语,,0,0,0,,看了 你已经
Dialogue: 0,0:04:19.64,0:04:20.67,优酷剧集英语,,0,0,0,,嘘
Dialogue: 0,0:04:21.16,0:04:22.20,优酷剧集英语,,0,0,0,,萧逸水啊
Dialogue: 0,0:04:22.20,0:04:23.92,优酷剧集英语,,0,0,0,,真的是在罗准家里抓着的
Dialogue: 0,0:04:24.20,0:04:25.60,优酷剧集英语,,0,0,0,,我们要晚去一步
Dialogue: 0,0:04:25.60,0:04:27.60,优酷剧集英语,,0,0,0,,罗准就被大卸八块了
Dialogue: 0,0:04:28.72,0:04:29.76,优酷剧集英语,,0,0,0,,消息很准啊
Dialogue: 0,0:04:30.27,0:04:33.64,优酷剧集英语,,0,0,0,,瞎猜的 还是顾巡使厉害
Dialogue: 0,0:04:34.07,0:04:35.16,优酷剧集英语,,0,0,0,,请你过来呢
Dialogue: 0,0:04:35.92,0:04:37.07,优酷剧集英语,,0,0,0,,是想让你啊
Dialogue: 0,0:04:37.44,0:04:39.72,优酷剧集英语,,0,0,0,,帮我们审一审这个萧逸水
Dialogue: 0,0:04:40.51,0:04:41.27,优酷剧集英语,,0,0,0,,不不不
Dialogue: 0,0:04:41.27,0:04:43.35,优酷剧集英语,,0,0,0,,开封府自有奖赏
Dialogue: 0,0:04:43.88,0:04:44.67,优酷剧集英语,,0,0,0,,顾巡使
Dialogue: 0,0:04:45.64,0:04:47.27,优酷剧集英语,,0,0,0,,钱固然重要
Dialogue: 0,0:04:47.79,0:04:49.04,优酷剧集英语,,0,0,0,,可是这萧逸水啊
Dialogue: 0,0:04:49.04,0:04:50.48,优酷剧集英语,,0,0,0,,是个亡命之徒
Dialogue: 0,0:04:51.07,0:04:52.35,优酷剧集英语,,0,0,0,,我有点不敢
Dialogue: 0,0:04:53.00,0:04:54.00,优酷剧集英语,,0,0,0,,他在哪儿呀
Dialogue: 0,0:05:02.47,0:05:03.95,优酷剧集英语,,0,0,0,,他天天砸这个墙
Dialogue: 0,0:05:03.95,0:05:05.64,优酷剧集英语,,0,0,0,,说把墙砸破了以后
Dialogue: 0,0:05:05.64,0:05:08.00,优酷剧集英语,,0,0,0,,出去找你们全家杀了
Dialogue: 0,0:05:09.67,0:05:10.44,优酷剧集英语,,0,0,0,,顾巡使
Dialogue: 0,0:05:10.44,0:05:11.76,优酷剧集英语,,0,0,0,,我 我审他
Dialogue: 0,0:05:12.20,0:05:13.23,优酷剧集英语,,0,0,0,,审他什么呀
Dialogue: 0,0:05:15.95,0:05:16.76,优酷剧集英语,,0,0,0,,这个呀
Dialogue: 0,0:05:17.20,0:05:20.60,优酷剧集英语,,0,0,0,,是狄伦写给他真正背后人的信
Dialogue: 0,0:05:21.44,0:05:23.07,优酷剧集英语,,0,0,0,,从他身上搜出来的
Dialogue: 0,0:05:23.60,0:05:26.07,优酷剧集英语,,0,0,0,,也许待会儿你能用得上
Dialogue: 0,0:05:37.07,0:05:37.88,优酷剧集英语,,0,0,0,,萧哥
Dialogue: 0,0:05:39.88,0:05:40.88,优酷剧集英语,,0,0,0,,直娘贼
Dialogue: 0,0:05:41.23,0:05:43.04,优酷剧集英语,,0,0,0,,是你报的官府害我
Dialogue: 0,0:05:43.60,0:05:44.32,优酷剧集英语,,0,0,0,,过来
Dialogue: 0,0:05:44.92,0:05:45.64,优酷剧集英语,,0,0,0,,过来
Dialogue: 0,0:05:46.00,0:05:47.51,优酷剧集英语,,0,0,0,,我弄死你 过来
Dialogue: 0,0:05:48.27,0:05:49.00,优酷剧集英语,,0,0,0,,过来
Dialogue: 0,0:05:49.55,0:05:50.35,优酷剧集英语,,0,0,0,,想干什么
Dialogue: 0,0:05:51.00,0:05:52.76,优酷剧集英语,,0,0,0,,你出来 你出来
Dialogue: 0,0:05:56.00,0:05:56.72,优酷剧集英语,,0,0,0,,过来
Dialogue: 0,0:05:57.83,0:05:58.23,优酷剧集英语,,0,0,0,,你
Dialogue: 0,0:05:58.48,0:05:59.00,优酷剧集英语,,0,0,0,,你等我啊
Dialogue: 0,0:05:59.00,0:06:00.51,优酷剧集英语,,0,0,0,,我一会儿再找你算账
Dialogue: 0,0:06:07.60,0:06:08.44,优酷剧集英语,,0,0,0,,萧逸水
Dialogue: 0,0:06:11.55,0:06:14.32,优酷剧集英语,,0,0,0,,你不是想报杀父之仇吗
Dialogue: 0,0:06:16.16,0:06:18.04,优酷剧集英语,,0,0,0,,这个 你认得
Dialogue: 0,0:06:26.64,0:06:28.60,优酷剧集英语,,0,0,0,,这是我杀父仇人的笔迹
Dialogue: 0,0:06:29.64,0:06:31.27,优酷剧集英语,,0,0,0,,你是从哪儿得来的
Dialogue: 0,0:06:32.79,0:06:34.00,优酷剧集英语,,0,0,0,,我要帮你的话
Dialogue: 0,0:06:34.35,0:06:35.44,优酷剧集英语,,0,0,0,,我有什么好处
Dialogue: 0,0:06:35.60,0:06:36.48,优酷剧集英语,,0,0,0,,什么都可以
Dialogue: 0,0:06:37.48,0:06:38.39,优酷剧集英语,,0,0,0,,等我出去
Dialogue: 0,0:06:38.39,0:06:39.83,优酷剧集英语,,0,0,0,,我给你做牛做马
Dialogue: 0,0:06:42.48,0:06:43.64,优酷剧集英语,,0,0,0,,这个人
Dialogue: 0,0:06:44.07,0:06:45.16,优酷剧集英语,,0,0,0,,叫狄伦
Dialogue: 0,0:06:45.39,0:06:47.20,优酷剧集英语,,0,0,0,,是大理寺的司直
Dialogue: 0,0:06:47.79,0:06:50.95,优酷剧集英语,,0,0,0,,但是人我已经帮你杀了
Dialogue: 0,0:06:54.07,0:06:55.07,优酷剧集英语,,0,0,0,,我杀的
Dialogue: 0,0:07:03.35,0:07:05.00,优酷剧集英语,,0,0,0,,我凭什么信你啊
Dialogue: 0,0:07:11.64,0:07:12.83,优酷剧集英语,,0,0,0,,给我吧
Dialogue: 0,0:07:12.83,0:07:13.64,优酷剧集英语,,0,0,0,,窝囊样
Dialogue: 0,0:07:16.16,0:07:18.79,优酷剧集英语,,0,0,0,,现查明毁坏祥瑞者
Dialogue: 0,0:07:18.79,0:07:20.35,优酷剧集英语,,0,0,0,,为外来贼寇
Dialogue: 0,0:07:20.35,0:07:22.44,优酷剧集英语,,0,0,0,,受奸人挑唆所致
Dialogue: 0,0:07:22.83,0:07:25.55,优酷剧集英语,,0,0,0,,另有一女子温悦及其夫
Dialogue: 0,0:07:25.72,0:07:28.07,优酷剧集英语,,0,0,0,,大理寺贴书吏赵不尤
Dialogue: 0,0:07:28.23,0:07:29.79,优酷剧集英语,,0,0,0,,从中接应
Dialogue: 0,0:07:30.79,0:07:34.35,优酷剧集英语,,0,0,0,,吾必全力以赴查出幕后主使
Dialogue: 0,0:07:35.76,0:07:38.88,优酷剧集英语,,0,0,0,,届时负荆请罪
Dialogue: 0,0:07:40.92,0:07:42.00,优酷剧集英语,,0,0,0,,你信了吧
Dialogue: 0,0:07:46.92,0:07:47.72,优酷剧集英语,,0,0,0,,信了
Dialogue: 0,0:07:50.88,0:07:53.23,优酷剧集英语,,0,0,0,,这封信如果送出去
Dialogue: 0,0:07:54.64,0:07:57.20,优酷剧集英语,,0,0,0,,你跟小九应该都死了
Dialogue: 0,0:07:58.23,0:07:59.67,优酷剧集英语,,0,0,0,,所以我杀了他
Dialogue: 0,0:08:06.23,0:08:08.44,优酷剧集英语,,0,0,0,,老子为了这个仇人
Dialogue: 0,0:08:08.44,0:08:10.35,优酷剧集英语,,0,0,0,,找了他十五年
Dialogue: 0,0:08:12.35,0:08:17.39,优酷剧集英语,,0,0,0,,竟然死在你这个窝囊废的手里
Dialogue: 0,0:08:29.20,0:08:30.04,优酷剧集英语,,0,0,0,,也罢
Dialogue: 0,0:08:31.64,0:08:32.71,优酷剧集英语,,0,0,0,,天意
Dialogue: 0,0:08:37.84,0:08:38.71,优酷剧集英语,,0,0,0,,说吧
Dialogue: 0,0:08:40.44,0:08:43.59,优酷剧集英语,,0,0,0,,有什么事情是我可以替你做的
Dialogue: 0,0:08:47.71,0:08:49.03,优酷剧集英语,,0,0,0,,我就问你三个问题
Dialogue: 0,0:08:49.71,0:08:50.52,优酷剧集英语,,0,0,0,,问
Dialogue: 0,0:08:57.47,0:08:58.44,优酷剧集英语,,0,0,0,,除了甘亮
Dialogue: 0,0:09:00.35,0:09:03.40,优酷剧集英语,,0,0,0,,有没有把我娘子身份告诉别人
Dialogue: 0,0:09:05.23,0:09:07.40,优酷剧集英语,,0,0,0,,你当老子是个嚼舌婆子
Dialogue: 0,0:09:10.47,0:09:13.00,优酷剧集英语,,0,0,0,,还有 十五年前的证据
Dialogue: 0,0:09:13.44,0:09:14.52,优酷剧集英语,,0,0,0,,你怎么得到的
Dialogue: 0,0:09:15.23,0:09:17.40,优酷剧集英语,,0,0,0,,做我们这行有个规矩
Dialogue: 0,0:09:17.79,0:09:20.00,优酷剧集英语,,0,0,0,,如果发单人不想露面的话
Dialogue: 0,0:09:20.40,0:09:22.71,优酷剧集英语,,0,0,0,,就在包袱皮上写个匕字
Dialogue: 0,0:09:22.88,0:09:24.91,优酷剧集英语,,0,0,0,,然后包袱里放上银两
Dialogue: 0,0:09:24.91,0:09:26.28,优酷剧集英语,,0,0,0,,还有指令信笺
Dialogue: 0,0:09:26.47,0:09:28.40,优酷剧集英语,,0,0,0,,发单人这单就算发出来了
Dialogue: 0,0:09:29.59,0:09:30.91,优酷剧集英语,,0,0,0,,接到这单的时候
Dialogue: 0,0:09:30.91,0:09:32.91,优酷剧集英语,,0,0,0,,我本来以为是个寻常活儿
Dialogue: 0,0:09:33.47,0:09:36.47,优酷剧集英语,,0,0,0,,不承想里边包的不是银两
Dialogue: 0,0:09:37.03,0:09:38.47,优酷剧集英语,,0,0,0,,是我爹的金牙
Dialogue: 0,0:09:39.03,0:09:41.91,优酷剧集英语,,0,0,0,,还有一封信和那两张证据
Dialogue: 0,0:09:43.47,0:09:45.40,优酷剧集英语,,0,0,0,,只是那封信古怪得很
Dialogue: 0,0:09:45.67,0:09:48.28,优酷剧集英语,,0,0,0,,是从书上剪下来的字贴成的
Dialogue: 0,0:09:48.71,0:09:49.96,优酷剧集英语,,0,0,0,,信里告诉了我
Dialogue: 0,0:09:50.15,0:09:51.91,优酷剧集英语,,0,0,0,,我爹的被害真相
Dialogue: 0,0:09:52.88,0:09:54.11,优酷剧集英语,,0,0,0,,还告诉我
Dialogue: 0,0:09:54.11,0:09:55.23,优酷剧集英语,,0,0,0,,害我爹的人
Dialogue: 0,0:09:55.23,0:09:57.08,优酷剧集英语,,0,0,0,,在清明要搞假祥瑞
Dialogue: 0,0:09:57.64,0:10:00.71,优酷剧集英语,,0,0,0,,报复他的办法就是上船把人杀了
Dialogue: 0,0:10:00.71,0:10:02.08,优酷剧集英语,,0,0,0,,破了他的假祥瑞
Dialogue: 0,0:10:05.47,0:10:06.35,优酷剧集英语,,0,0,0,,我再问你
Dialogue: 0,0:10:06.47,0:10:07.84,优酷剧集英语,,0,0,0,,你到东京城
Dialogue: 0,0:10:07.84,0:10:09.35,优酷剧集英语,,0,0,0,,你怎么找到我娘子的
Dialogue: 0,0:10:09.67,0:10:12.67,优酷剧集英语,,0,0,0,,我得去大理寺拿到那份卷宗啊
Dialogue: 0,0:10:13.91,0:10:15.96,优酷剧集英语,,0,0,0,,我就每天去大理寺蹲着
Dialogue: 0,0:10:16.32,0:10:18.32,优酷剧集英语,,0,0,0,,看看有什么办法能混进去
Dialogue: 0,0:10:20.28,0:10:22.47,优酷剧集英语,,0,0,0,,她给你送饭的时候被我撞见了
Dialogue: 0,0:10:24.64,0:10:28.03,优酷剧集英语,,0,0,0,,我还以为她跟我爹一起走了呢
Dialogue: 0,0:10:28.03,0:10:30.08,优酷剧集英语,,0,0,0,,我娘子福大命大
Dialogue: 0,0:10:30.84,0:10:31.96,优酷剧集英语,,0,0,0,,活得好好的
Dialogue: 0,0:10:32.91,0:10:33.71,优酷剧集英语,,0,0,0,,另外
Dialogue: 0,0:10:34.23,0:10:35.96,优酷剧集英语,,0,0,0,,她不是给我送过一次饭
Dialogue: 0,0:10:36.08,0:10:38.23,优酷剧集英语,,0,0,0,,这十几年来风雨不改
Dialogue: 0,0:10:38.23,0:10:39.84,优酷剧集英语,,0,0,0,,一直在给我送饭
Dialogue: 0,0:10:40.76,0:10:42.35,优酷剧集英语,,0,0,0,,给老子滚一边去
Dialogue: 0,0:10:42.91,0:10:44.03,优酷剧集英语,,0,0,0,,记住啊
Dialogue: 0,0:10:44.59,0:10:48.03,优酷剧集英语,,0,0,0,,小九是我的女人
Dialogue: 0,0:10:48.64,0:10:49.64,优酷剧集英语,,0,0,0,,我的
Dialogue: 0,0:10:50.55,0:10:53.52,优酷剧集英语,,0,0,0,,等我出去 我就去找她
Dialogue: 0,0:10:55.28,0:10:56.08,优酷剧集英语,,0,0,0,,萧逸水
Dialogue: 0,0:10:58.28,0:10:59.44,优酷剧集英语,,0,0,0,,你有家仇
Dialogue: 0,0:10:59.96,0:11:01.20,优酷剧集英语,,0,0,0,,我有家人
Dialogue: 0,0:11:02.03,0:11:03.08,优酷剧集英语,,0,0,0,,我告诉你
Dialogue: 0,0:11:03.67,0:11:05.88,优酷剧集英语,,0,0,0,,你要敢动我娘子一根毫毛
Dialogue: 0,0:11:06.64,0:11:07.64,优酷剧集英语,,0,0,0,,我杀了你
Dialogue: 0,0:11:19.64,0:11:20.23,优酷剧集英语,,0,0,0,,赵不尤
Dialogue: 0,0:11:20.23,0:11:21.55,优酷剧集英语,,0,0,0,,我真看错了
Dialogue: 0,0:11:21.55,0:11:22.79,优酷剧集英语,,0,0,0,,你个窝囊废了
Dialogue: 0,0:11:22.79,0:11:24.55,优酷剧集英语,,0,0,0,,来 杀我 现在就来
Dialogue: 0,0:11:24.64,0:11:25.44,优酷剧集英语,,0,0,0,,来呀
Dialogue: 0,0:11:25.88,0:11:26.47,优酷剧集英语,,0,0,0,,来
Dialogue: 0,0:11:26.47,0:11:28.52,优酷剧集英语,,0,0,0,,来 杀我呀
Dialogue: 0,0:11:29.23,0:11:31.59,优酷剧集英语,,0,0,0,,小九 等着哥哥
Dialogue: 0,0:11:31.59,0:11:32.35,优酷剧集英语,,0,0,0,,我
Dialogue: 0,0:11:33.35,0:11:34.32,优酷剧集英语,,0,0,0,,干什么 赵不尤
Dialogue: 0,0:11:34.91,0:11:35.23,优酷剧集英语,,0,0,0,,松开
Dialogue: 0,0:11:35.23,0:11:36.03,优酷剧集英语,,0,0,0,,我杀了他
Dialogue: 0,0:11:36.96,0:11:37.47,优酷剧集英语,,0,0,0,,松开
Dialogue: 0,0:11:37.59,0:11:38.20,优酷剧集英语,,0,0,0,,松开
Dialogue: 0,0:11:38.52,0:11:39.11,优酷剧集英语,,0,0,0,,松开
Dialogue: 0,0:11:40.11,0:11:40.96,优酷剧集英语,,0,0,0,,赵不尤
Dialogue: 0,0:11:47.52,0:11:48.91,优酷剧集英语,,0,0,0,,还要杀了我
Dialogue: 0,0:11:53.67,0:11:54.47,优酷剧集英语,,0,0,0,,万推司
Dialogue: 0,0:11:56.55,0:11:59.20,优酷剧集英语,,0,0,0,,他如果找我娘子 我可怎么办
Dialogue: 0,0:12:02.03,0:12:03.64,优酷剧集英语,,0,0,0,,你动脑子想一想
Dialogue: 0,0:12:04.23,0:12:06.23,优酷剧集英语,,0,0,0,,犯那么大事 杀那么多人
Dialogue: 0,0:12:07.03,0:12:07.91,优酷剧集英语,,0,0,0,,出不去了
Dialogue: 0,0:12:11.76,0:12:12.44,优酷剧集英语,,0,0,0,,出不去了
Dialogue: 0,0:12:12.47,0:12:13.32,优酷剧集英语,,0,0,0,,出不去
Dialogue: 0,0:12:13.55,0:12:14.59,优酷剧集英语,,0,0,0,,我知道
Dialogue: 0,0:12:26.88,0:12:27.71,优酷剧集英语,,0,0,0,,顾巡使
Dialogue: 0,0:12:28.15,0:12:28.96,优酷剧集英语,,0,0,0,,顾巡使
Dialogue: 0,0:12:32.55,0:12:34.40,优酷剧集英语,,0,0,0,,您在开封府的后面
Dialogue: 0,0:12:34.79,0:12:37.00,优酷剧集英语,,0,0,0,,开了一个这么大的菜园子
Dialogue: 0,0:12:37.11,0:12:39.44,优酷剧集英语,,0,0,0,,从前这地方种满了花花草草
Dialogue: 0,0:12:39.67,0:12:40.71,优酷剧集英语,,0,0,0,,但我觉得吧
Dialogue: 0,0:12:40.84,0:12:42.91,优酷剧集英语,,0,0,0,,不实用 我就都给起了
Dialogue: 0,0:12:43.52,0:12:44.44,优酷剧集英语,,0,0,0,,全种上了菜
Dialogue: 0,0:12:44.91,0:12:46.52,优酷剧集英语,,0,0,0,,你为什么喜欢种菜啊
Dialogue: 0,0:12:47.52,0:12:49.67,优酷剧集英语,,0,0,0,,从前在泾原军打仗的时候
Dialogue: 0,0:12:50.00,0:12:50.96,优酷剧集英语,,0,0,0,,补给困难
Dialogue: 0,0:12:51.28,0:12:52.32,优酷剧集英语,,0,0,0,,我大哥李言
Dialogue: 0,0:12:52.32,0:12:54.35,优酷剧集英语,,0,0,0,,就把军营附近都种满了菜
Dialogue: 0,0:12:54.84,0:12:55.71,优酷剧集英语,,0,0,0,,菜金贵啊
Dialogue: 0,0:12:56.71,0:12:58.35,优酷剧集英语,,0,0,0,,你是希望种菜
Dialogue: 0,0:12:58.35,0:13:00.28,优酷剧集英语,,0,0,0,,来缅怀你的大哥李言
Dialogue: 0,0:13:00.28,0:13:02.32,优酷剧集英语,,0,0,0,,我种菜就是为了吃
Dialogue: 0,0:13:03.32,0:13:05.35,优酷剧集英语,,0,0,0,,对 李言大哥也爱吃
Dialogue: 0,0:13:06.03,0:13:06.96,优酷剧集英语,,0,0,0,,这个叫什么
Dialogue: 0,0:13:07.35,0:13:08.20,优酷剧集英语,,0,0,0,,这个叫莴苣
Dialogue: 0,0:13:09.28,0:13:11.88,优酷剧集英语,,0,0,0,,我娘子说这是可以生吃的
Dialogue: 0,0:13:13.08,0:13:14.28,优酷剧集英语,,0,0,0,,我打过粪
Dialogue: 0,0:13:19.20,0:13:21.03,优酷剧集英语,,0,0,0,,你呀 要没事
Dialogue: 0,0:13:21.59,0:13:22.88,优酷剧集英语,,0,0,0,,帮我把那片韭菜收了
Dialogue: 0,0:13:23.59,0:13:24.40,优酷剧集英语,,0,0,0,,顾巡使
Dialogue: 0,0:13:24.40,0:13:25.28,优酷剧集英语,,0,0,0,,别吃啊
Dialogue: 0,0:13:35.71,0:13:36.52,优酷剧集英语,,0,0,0,,顾巡使
Dialogue: 0,0:13:37.28,0:13:38.32,优酷剧集英语,,0,0,0,,韭菜拔好了
Dialogue: 0,0:13:39.11,0:13:40.00,优酷剧集英语,,0,0,0,,你看够不够
Dialogue: 0,0:13:40.00,0:13:41.71,优酷剧集英语,,0,0,0,,你把韭菜都给我拔出来了
Dialogue: 0,0:13:43.52,0:13:44.03,优酷剧集英语,,0,0,0,,对
Dialogue: 0,0:13:44.71,0:13:45.76,优酷剧集英语,,0,0,0,,不拔 那
Dialogue: 0,0:13:47.23,0:13:48.76,优酷剧集英语,,0,0,0,,这个韭菜啊
Dialogue: 0,0:13:49.35,0:13:50.79,优酷剧集英语,,0,0,0,,是用来割的
Dialogue: 0,0:13:51.08,0:13:52.35,优酷剧集英语,,0,0,0,,割韭菜割韭菜
Dialogue: 0,0:13:52.35,0:13:53.59,优酷剧集英语,,0,0,0,,你没听说过吗
Dialogue: 0,0:13:54.20,0:13:55.67,优酷剧集英语,,0,0,0,,我下次注意啊
Dialogue: 0,0:13:56.11,0:13:57.52,优酷剧集英语,,0,0,0,,在拔韭菜的时候
Dialogue: 0,0:13:57.67,0:13:59.00,优酷剧集英语,,0,0,0,,我心里在想
Dialogue: 0,0:13:59.91,0:14:02.28,优酷剧集英语,,0,0,0,,李言大哥在天有灵
Dialogue: 0,0:14:02.67,0:14:04.11,优酷剧集英语,,0,0,0,,应该是可以安息
Dialogue: 0,0:14:04.88,0:14:06.67,优酷剧集英语,,0,0,0,,你也算是为他报了仇了
Dialogue: 0,0:14:06.88,0:14:09.52,优酷剧集英语,,0,0,0,,我现在只是把台前的一个小丑
Dialogue: 0,0:14:09.64,0:14:10.88,优酷剧集英语,,0,0,0,,狄伦给
Dialogue: 0,0:14:12.96,0:14:14.32,优酷剧集英语,,0,0,0,,不算是报仇吧
Dialogue: 0,0:14:16.03,0:14:16.84,优酷剧集英语,,0,0,0,,顾巡使
Dialogue: 0,0:14:18.11,0:14:20.91,优酷剧集英语,,0,0,0,,那天狄伦死之前说他背后有人
Dialogue: 0,0:14:20.96,0:14:22.76,优酷剧集英语,,0,0,0,,你已经猜到那位是谁了吧
Dialogue: 0,0:14:23.67,0:14:24.91,优酷剧集英语,,0,0,0,,当年我大哥李言
Dialogue: 0,0:14:26.52,0:14:28.96,优酷剧集英语,,0,0,0,,调任两浙路转运副使
Dialogue: 0,0:14:29.76,0:14:32.11,优酷剧集英语,,0,0,0,,当地有位大人物
Dialogue: 0,0:14:32.15,0:14:35.40,优酷剧集英语,,0,0,0,,为官家各处搜罗奇珍异石
Dialogue: 0,0:14:37.00,0:14:38.32,优酷剧集英语,,0,0,0,,横征暴敛
Dialogue: 0,0:14:38.59,0:14:39.91,优酷剧集英语,,0,0,0,,欺压百姓
Dialogue: 0,0:14:40.35,0:14:43.47,优酷剧集英语,,0,0,0,,我大哥就弹劾了他几次
Dialogue: 0,0:14:43.71,0:14:44.76,优酷剧集英语,,0,0,0,,结下仇了
Dialogue: 0,0:14:45.88,0:14:47.59,优酷剧集英语,,0,0,0,,你大哥弹劾的这个人
Dialogue: 0,0:14:47.96,0:14:50.88,优酷剧集英语,,0,0,0,,可是有东南小朝廷之称的那位
Dialogue: 0,0:14:51.15,0:14:52.08,优酷剧集英语,,0,0,0,,邹勉
Dialogue: 0,0:14:55.32,0:14:57.84,优酷剧集英语,,0,0,0,,狄伦背后的靠山是邹勉
Dialogue: 0,0:14:58.20,0:15:00.00,优酷剧集英语,,0,0,0,,他授意狄伦造假祥瑞
Dialogue: 0,0:15:00.00,0:15:00.96,优酷剧集英语,,0,0,0,,讨好官家
Dialogue: 0,0:15:01.79,0:15:02.91,优酷剧集英语,,0,0,0,,萧逸水背后
Dialogue: 0,0:15:03.00,0:15:04.84,优酷剧集英语,,0,0,0,,有一股神秘的势力
Dialogue: 0,0:15:05.15,0:15:07.23,优酷剧集英语,,0,0,0,,他们则刻意破坏假祥瑞
Dialogue: 0,0:15:07.96,0:15:09.96,优酷剧集英语,,0,0,0,,看似台前两个小鬼在打架
Dialogue: 0,0:15:10.35,0:15:12.59,优酷剧集英语,,0,0,0,,实际是背后的神仙
Dialogue: 0,0:15:13.44,0:15:14.32,优酷剧集英语,,0,0,0,,在斗法
Dialogue: 0,0:15:15.08,0:15:15.88,优酷剧集英语,,0,0,0,,是的
Dialogue: 0,0:15:19.59,0:15:20.91,优酷剧集英语,,0,0,0,,神仙打架
Dialogue: 0,0:15:21.55,0:15:23.79,优酷剧集英语,,0,0,0,,老百姓还是别抬头看为妙
Dialogue: 0,0:15:24.55,0:15:26.64,优酷剧集英语,,0,0,0,,可要是连头都不敢抬
Dialogue: 0,0:15:27.32,0:15:31.64,优酷剧集英语,,0,0,0,,那这活着跟猪狗又有什么区别
Dialogue: 0,0:15:33.96,0:15:34.79,优酷剧集英语,,0,0,0,,顾巡使
Dialogue: 0,0:15:35.91,0:15:37.28,优酷剧集英语,,0,0,0,,你说的这句
Dialogue: 0,0:15:38.35,0:15:39.76,优酷剧集英语,,0,0,0,,打到我心里去了
Dialogue: 0,0:15:44.55,0:15:45.88,优酷剧集英语,,0,0,0,,我帮你收拾一下这里
Dialogue: 0,0:15:48.52,0:15:49.79,优酷剧集英语,,0,0,0,,你是不是想办邹勉
Dialogue: 0,0:15:50.76,0:15:53.20,优酷剧集英语,,0,0,0,,我顾某这一生
Dialogue: 0,0:15:53.47,0:15:56.28,优酷剧集英语,,0,0,0,,定要叫他人头落地
Dialogue: 0,0:15:59.47,0:16:01.03,优酷剧集英语,,0,0,0,,但他势力太大了
Dialogue: 0,0:16:03.20,0:16:04.08,优酷剧集英语,,0,0,0,,不着急
Dialogue: 0,0:16:05.20,0:16:06.44,优酷剧集英语,,0,0,0,,总会有机会的
Dialogue: 0,0:16:14.88,0:16:16.20,优酷剧集英语,,0,0,0,,我跟你打听个事
Dialogue: 0,0:16:17.55,0:16:19.84,优酷剧集英语,,0,0,0,,那天我听万福说
Dialogue: 0,0:16:20.35,0:16:23.00,优酷剧集英语,,0,0,0,,底下人有底下人挣钱的法子
Dialogue: 0,0:16:23.67,0:16:25.23,优酷剧集英语,,0,0,0,,改天能让他教教我吗
Dialogue: 0,0:16:31.08,0:16:31.79,优酷剧集英语,,0,0,0,,来
Dialogue: 0,0:16:32.52,0:16:34.55,优酷剧集英语,,0,0,0,,我置宅就靠你了
Dialogue: 0,0:16:36.08,0:16:37.84,优酷剧集英语,,0,0,0,,你置宅最好还是靠自己
Dialogue: 0,0:16:38.32,0:16:39.40,优酷剧集英语,,0,0,0,,对 那肯定
Dialogue: 0,0:16:50.08,0:16:51.00,优酷剧集英语,,0,0,0,,赵不尤
Dialogue: 0,0:16:52.08,0:16:55.08,优酷剧集英语,,0,0,0,,你昨天回家到现在心情都特别好
Dialogue: 0,0:16:55.91,0:16:58.11,优酷剧集英语,,0,0,0,,什么好事 都捂馊了吧
Dialogue: 0,0:16:58.11,0:16:59.11,优酷剧集英语,,0,0,0,,看出来了
Dialogue: 0,0:17:01.91,0:17:04.83,优酷剧集英语,,0,0,0,,没人打扰的日子当然舒坦了
Dialogue: 0,0:17:06.71,0:17:07.92,优酷剧集英语,,0,0,0,,告诉你个好消息
Dialogue: 0,0:17:08.16,0:17:10.04,优酷剧集英语,,0,0,0,,你的大师兄萧逸水
Dialogue: 0,0:17:10.19,0:17:11.76,优酷剧集英语,,0,0,0,,被抓了 出不来了
Dialogue: 0,0:17:11.80,0:17:12.52,优酷剧集英语,,0,0,0,,他被抓了
Dialogue: 0,0:17:12.52,0:17:13.80,优酷剧集英语,,0,0,0,,你高兴什么呀
Dialogue: 0,0:17:14.92,0:17:17.16,优酷剧集英语,,0,0,0,,他被抓了 你难过什么呀
Dialogue: 0,0:17:17.16,0:17:17.80,优酷剧集英语,,0,0,0,,我
Dialogue: 0,0:17:22.76,0:17:24.35,优酷剧集英语,,0,0,0,,我不是担心他
Dialogue: 0,0:17:25.19,0:17:26.23,优酷剧集英语,,0,0,0,,他是江湖人
Dialogue: 0,0:17:26.23,0:17:27.35,优酷剧集英语,,0,0,0,,自然有江湖命
Dialogue: 0,0:17:27.59,0:17:29.16,优酷剧集英语,,0,0,0,,我是担心他被抓了
Dialogue: 0,0:17:29.35,0:17:30.16,优酷剧集英语,,0,0,0,,把
Dialogue: 0,0:17:30.76,0:17:31.92,优酷剧集英语,,0,0,0,,把我的事说出来
Dialogue: 0,0:17:31.92,0:17:32.56,优酷剧集英语,,0,0,0,,怎么办
Dialogue: 0,0:17:33.00,0:17:34.31,优酷剧集英语,,0,0,0,,你大师兄那个人
Dialogue: 0,0:17:34.31,0:17:35.31,优酷剧集英语,,0,0,0,,倒也恩怨分明
Dialogue: 0,0:17:35.71,0:17:38.00,优酷剧集英语,,0,0,0,,但是呢他身上背了几条人命案
Dialogue: 0,0:17:38.31,0:17:39.52,优酷剧集英语,,0,0,0,,出是出不来了
Dialogue: 0,0:17:40.92,0:17:43.76,优酷剧集英语,,0,0,0,,所以现在目前看 你我是安全的
Dialogue: 0,0:17:44.56,0:17:45.52,优酷剧集英语,,0,0,0,,过好日子
Dialogue: 0,0:17:50.88,0:17:52.04,优酷剧集英语,,0,0,0,,我也有一件事
Dialogue: 0,0:17:54.00,0:17:55.71,优酷剧集英语,,0,0,0,,那个太府寺的单子
Dialogue: 0,0:17:55.71,0:17:57.00,优酷剧集英语,,0,0,0,,最终我还是接了
Dialogue: 0,0:17:57.56,0:17:58.43,优酷剧集英语,,0,0,0,,太好了
Dialogue: 0,0:17:58.43,0:18:00.64,优酷剧集英语,,0,0,0,,这就叫大难不死必有后福
Dialogue: 0,0:18:02.35,0:18:03.80,优酷剧集英语,,0,0,0,,所以呢我也在想
Dialogue: 0,0:18:04.31,0:18:06.23,优酷剧集英语,,0,0,0,,确实应该把日子过好
Dialogue: 0,0:18:07.56,0:18:10.11,优酷剧集英语,,0,0,0,,就算是问解库多贷一些
Dialogue: 0,0:18:10.16,0:18:11.35,优酷剧集英语,,0,0,0,,今天也一定
Dialogue: 0,0:18:11.35,0:18:13.64,优酷剧集英语,,0,0,0,,要把麦秸巷那套宅子定下来
Dialogue: 0,0:18:17.04,0:18:18.16,优酷剧集英语,,0,0,0,,一定要买宅子
Dialogue: 0,0:18:19.31,0:18:20.28,优酷剧集英语,,0,0,0,,当然了
Dialogue: 0,0:18:20.28,0:18:21.40,优酷剧集英语,,0,0,0,,不是说过了吗
Dialogue: 0,0:18:22.43,0:18:24.76,优酷剧集英语,,0,0,0,,有自己的宅子才像家
Dialogue: 0,0:18:26.47,0:18:27.19,优酷剧集英语,,0,0,0,,也是
Dialogue: 0,0:18:27.83,0:18:29.52,优酷剧集英语,,0,0,0,,我一会儿就去找黄行老
Dialogue: 0,0:18:29.68,0:18:31.16,优酷剧集英语,,0,0,0,,找他申请个讼师摊
Dialogue: 0,0:18:32.92,0:18:33.56,优酷剧集英语,,0,0,0,,买
Dialogue: 0,0:18:37.52,0:18:38.31,优酷剧集英语,,0,0,0,,赵墨儿
Dialogue: 0,0:18:38.59,0:18:39.23,优酷剧集英语,,0,0,0,,赵墨儿
Dialogue: 0,0:18:39.76,0:18:40.23,优酷剧集英语,,0,0,0,,人呢
Dialogue: 0,0:18:45.04,0:18:46.64,优酷剧集英语,,0,0,0,,你还在这儿干什么呢
Dialogue: 0,0:18:52.83,0:18:54.71,优酷剧集英语,,0,0,0,,你看上人家馒头西施了
Dialogue: 0,0:18:55.56,0:18:56.80,优酷剧集英语,,0,0,0,,第一次看你看女人
Dialogue: 0,0:18:56.80,0:18:58.35,优酷剧集英语,,0,0,0,,看得眼神发直了
Dialogue: 0,0:18:59.40,0:19:00.71,优酷剧集英语,,0,0,0,,她那个轮车啊
Dialogue: 0,0:19:00.80,0:19:02.19,优酷剧集英语,,0,0,0,,转向不方便
Dialogue: 0,0:19:03.00,0:19:04.56,优酷剧集英语,,0,0,0,,好了好了好了
Dialogue: 0,0:19:04.56,0:19:05.92,优酷剧集英语,,0,0,0,,赶紧吃完去办事
Dialogue: 0,0:19:05.92,0:19:08.11,优酷剧集英语,,0,0,0,,下午还要跟嫂子去看房呢
Dialogue: 0,0:19:15.11,0:19:16.68,优酷剧集英语,,0,0,0,,馒头来喽
Dialogue: 0,0:19:20.95,0:19:22.56,优酷剧集英语,,0,0,0,,馒头来喽
Dialogue: 0,0:19:23.71,0:19:24.35,优酷剧集英语,,0,0,0,,您的馒头
Dialogue: 0,0:19:26.11,0:19:27.56,优酷剧集英语,,0,0,0,,来来来 您的馒头
Dialogue: 0,0:19:29.52,0:19:30.80,优酷剧集英语,,0,0,0,,醋来喽 醋来喽
Dialogue: 0,0:19:41.59,0:19:43.11,优酷剧集英语,,0,0,0,,就算馒头再好吃
Dialogue: 0,0:19:43.31,0:19:45.11,优酷剧集英语,,0,0,0,,你也不用吃得这么生猛
Dialogue: 0,0:19:45.11,0:19:47.43,优酷剧集英语,,0,0,0,,你也不看看刚刚等座等了多久
Dialogue: 0,0:19:47.71,0:19:49.00,优酷剧集英语,,0,0,0,,馒头西施的手艺
Dialogue: 0,0:19:49.00,0:19:50.23,优酷剧集英语,,0,0,0,,你可不得好好尝尝
Dialogue: 0,0:19:50.56,0:19:52.80,优酷剧集英语,,0,0,0,,出来花钱吃的是味道
Dialogue: 0,0:19:52.80,0:19:54.11,优酷剧集英语,,0,0,0,,跟长相有什么关系
Dialogue: 0,0:19:54.23,0:19:55.56,优酷剧集英语,,0,0,0,,当然有关系了
Dialogue: 0,0:19:56.71,0:19:57.92,优酷剧集英语,,0,0,0,,馒头西施
Dialogue: 0,0:19:57.92,0:19:59.76,优酷剧集英语,,0,0,0,,卖的不就是这个招牌吗
Dialogue: 0,0:19:59.76,0:20:01.95,优酷剧集英语,,0,0,0,,武家三娘子多可怜啊
Dialogue: 0,0:20:02.43,0:20:03.88,优酷剧集英语,,0,0,0,,自幼腿疾瘫痪
Dialogue: 0,0:20:04.47,0:20:06.07,优酷剧集英语,,0,0,0,,但人家有个好哥哥
Dialogue: 0,0:20:06.35,0:20:07.95,优酷剧集英语,,0,0,0,,每天背人家上下工
Dialogue: 0,0:20:09.16,0:20:10.40,优酷剧集英语,,0,0,0,,你看人家哥哥
Dialogue: 0,0:20:10.80,0:20:12.11,优酷剧集英语,,0,0,0,,你若是瘫了
Dialogue: 0,0:20:12.11,0:20:14.40,优酷剧集英语,,0,0,0,,我肯定给你做一个更好的轮车
Dialogue: 0,0:20:14.47,0:20:15.64,优酷剧集英语,,0,0,0,,呸呸呸
Dialogue: 0,0:20:16.43,0:20:17.71,优酷剧集英语,,0,0,0,,说什么呢
Dialogue: 0,0:20:18.83,0:20:20.56,优酷剧集英语,,0,0,0,,即便我若是瘫了
Dialogue: 0,0:20:20.68,0:20:22.56,优酷剧集英语,,0,0,0,,我自己就能医好我自己
Dialogue: 0,0:20:22.56,0:20:24.00,优酷剧集英语,,0,0,0,,不用你那个轮车
Dialogue: 0,0:20:24.56,0:20:25.68,优酷剧集英语,,0,0,0,,吃你的馒头吧
Dialogue: 0,0:20:28.71,0:20:31.19,优酷剧集英语,,0,0,0,,二位客官是第一次到我小店吧
Dialogue: 0,0:20:32.07,0:20:33.35,优酷剧集英语,,0,0,0,,吃得可还好
Dialogue: 0,0:20:33.52,0:20:34.71,优酷剧集英语,,0,0,0,,味道好极了
Dialogue: 0,0:20:35.19,0:20:35.83,优酷剧集英语,,0,0,0,,二位
Dialogue: 0,0:20:37.11,0:20:38.64,优酷剧集英语,,0,0,0,,凡是到我们店的新客
Dialogue: 0,0:20:38.64,0:20:40.64,优酷剧集英语,,0,0,0,,我们都会送一张这样的条子
Dialogue: 0,0:20:42.64,0:20:43.47,优酷剧集英语,,0,0,0,,集齐四张
Dialogue: 0,0:20:43.47,0:20:46.11,优酷剧集英语,,0,0,0,,我们就会白送一份笋肉馒头
Dialogue: 0,0:20:47.80,0:20:48.83,优酷剧集英语,,0,0,0,,二位慢用啊
Dialogue: 0,0:20:48.83,0:20:49.52,优酷剧集英语,,0,0,0,,我去看看
Dialogue: 0,0:20:49.56,0:20:50.11,优酷剧集英语,,0,0,0,,好嘞
Dialogue: 0,0:20:50.76,0:20:51.92,优酷剧集英语,,0,0,0,,来来 让一下让一下
Dialogue: 0,0:20:52.40,0:20:53.40,优酷剧集英语,,0,0,0,,这怎么摔了
Dialogue: 0,0:20:53.52,0:20:54.47,优酷剧集英语,,0,0,0,,人没事吧
Dialogue: 0,0:20:54.64,0:20:56.07,优酷剧集英语,,0,0,0,,没事没事
Dialogue: 0,0:20:56.40,0:20:57.19,优酷剧集英语,,0,0,0,,不过这个
Dialogue: 0,0:20:57.83,0:20:59.56,优酷剧集英语,,0,0,0,,那就赶快把馒头跟盘子钱
Dialogue: 0,0:20:59.56,0:21:00.40,优酷剧集英语,,0,0,0,,付一下吧
Dialogue: 0,0:21:02.47,0:21:03.00,优酷剧集英语,,0,0,0,,不是
Dialogue: 0,0:21:03.52,0:21:06.16,优酷剧集英语,,0,0,0,,是他跑得着急撞的我
Dialogue: 0,0:21:06.52,0:21:07.23,优酷剧集英语,,0,0,0,,我这回去
Dialogue: 0,0:21:07.23,0:21:08.07,优酷剧集英语,,0,0,0,,是孙勃吗
Dialogue: 0,0:21:08.23,0:21:09.07,优酷剧集英语,,0,0,0,,他怎么回来了
Dialogue: 0,0:21:09.40,0:21:10.00,优酷剧集英语,,0,0,0,,那我是不是
Dialogue: 0,0:21:10.00,0:21:11.47,优酷剧集英语,,0,0,0,,还得再给你准备一份啊
Dialogue: 0,0:21:12.00,0:21:13.00,优酷剧集英语,,0,0,0,,谢谢啊
Dialogue: 0,0:21:13.00,0:21:14.43,优酷剧集英语,,0,0,0,,做什么梦呢
Dialogue: 0,0:21:14.80,0:21:16.23,优酷剧集英语,,0,0,0,,你个臭跑腿的
Dialogue: 0,0:21:16.23,0:21:17.80,优酷剧集英语,,0,0,0,,你瞎 你不看路
Dialogue: 0,0:21:17.80,0:21:18.71,优酷剧集英语,,0,0,0,,你撞着人家了
Dialogue: 0,0:21:18.71,0:21:19.83,优酷剧集英语,,0,0,0,,你还冤枉人家
Dialogue: 0,0:21:20.19,0:21:22.23,优酷剧集英语,,0,0,0,,你知道这碟子 这蟹肉馒头
Dialogue: 0,0:21:22.23,0:21:22.76,优酷剧集英语,,0,0,0,,你干吗呀
Dialogue: 0,0:21:22.76,0:21:23.64,优酷剧集英语,,0,0,0,,值多少钱吗
Dialogue: 0,0:21:23.64,0:21:24.47,优酷剧集英语,,0,0,0,,别过去了
Dialogue: 0,0:21:24.47,0:21:25.71,优酷剧集英语,,0,0,0,,现在过去人家多尴尬
Dialogue: 0,0:21:25.71,0:21:26.40,优酷剧集英语,,0,0,0,,下贱泥腿子
Dialogue: 0,0:21:26.64,0:21:29.23,优酷剧集英语,,0,0,0,,你来东京讨食一点规矩你都不懂
Dialogue: 0,0:21:29.40,0:21:30.28,优酷剧集英语,,0,0,0,,给我赔啊
Dialogue: 0,0:21:31.83,0:21:32.64,优酷剧集英语,,0,0,0,,掌柜的
Dialogue: 0,0:21:32.64,0:21:34.64,优酷剧集英语,,0,0,0,,这主要真的不是我的问题
Dialogue: 0,0:21:34.83,0:21:36.40,优酷剧集英语,,0,0,0,,再说了 我这跑一天腿
Dialogue: 0,0:21:36.40,0:21:37.80,优酷剧集英语,,0,0,0,,还不抵两个馒头呢
Dialogue: 0,0:21:37.80,0:21:39.11,优酷剧集英语,,0,0,0,,没钱有理啊
Dialogue: 0,0:21:39.23,0:21:40.71,优酷剧集英语,,0,0,0,,少废话 赔啊
Dialogue: 0,0:21:40.92,0:21:42.07,优酷剧集英语,,0,0,0,,不然我揍你啊
Dialogue: 0,0:21:42.23,0:21:42.92,优酷剧集英语,,0,0,0,,孙勃
Dialogue: 0,0:21:43.40,0:21:44.00,优酷剧集英语,,0,0,0,,孙勃
Dialogue: 0,0:21:45.11,0:21:45.83,优酷剧集英语,,0,0,0,,孙勃
Dialogue: 0,0:21:47.16,0:21:48.19,优酷剧集英语,,0,0,0,,我现在身上没带钱
Dialogue: 0,0:21:48.19,0:21:50.07,优酷剧集英语,,0,0,0,,我回去取了给您送来 对不起
Dialogue: 0,0:21:50.07,0:21:51.04,优酷剧集英语,,0,0,0,,你给我送过来啊
Dialogue: 0,0:21:51.04,0:21:52.19,优酷剧集英语,,0,0,0,,孙勃 孙
Dialogue: 0,0:21:58.76,0:21:59.56,优酷剧集英语,,0,0,0,,人呢
Dialogue: 0,0:22:01.56,0:22:02.59,优酷剧集英语,,0,0,0,,我跟你说了
Dialogue: 0,0:22:02.59,0:22:04.64,优酷剧集英语,,0,0,0,,你别上去跟人家打招呼
Dialogue: 0,0:22:04.64,0:22:06.28,优酷剧集英语,,0,0,0,,那多不合时宜啊
Dialogue: 0,0:22:08.43,0:22:10.00,优酷剧集英语,,0,0,0,,你打小就不合群
Dialogue: 0,0:22:10.23,0:22:12.00,优酷剧集英语,,0,0,0,,所有人都觉得你是怪人
Dialogue: 0,0:22:12.16,0:22:13.76,优酷剧集英语,,0,0,0,,只有他肯带着你玩
Dialogue: 0,0:22:16.00,0:22:17.47,优酷剧集英语,,0,0,0,,不知当年他们家
Dialogue: 0,0:22:17.59,0:22:19.16,优酷剧集英语,,0,0,0,,为何突然搬离东京
Dialogue: 0,0:22:20.88,0:22:22.52,优酷剧集英语,,0,0,0,,或许是因为
Dialogue: 0,0:22:22.52,0:22:24.04,优酷剧集英语,,0,0,0,,跟你玩多了
Dialogue: 0,0:22:24.40,0:22:25.56,优酷剧集英语,,0,0,0,,玩出郁症了
Dialogue: 0,0:22:27.59,0:22:28.76,优酷剧集英语,,0,0,0,,时候不早了
Dialogue: 0,0:22:28.76,0:22:29.80,优酷剧集英语,,0,0,0,,我第一天上工呢
Dialogue: 0,0:22:29.80,0:22:30.40,优酷剧集英语,,0,0,0,,我得走了
Dialogue: 0,0:22:30.40,0:22:31.56,优酷剧集英语,,0,0,0,,你又要去祸害人家
Dialogue: 0,0:22:31.76,0:22:32.71,优酷剧集英语,,0,0,0,,医馆在这边
Dialogue: 0,0:22:33.76,0:22:34.59,优酷剧集英语,,0,0,0,,酉时啊
Dialogue: 0,0:22:34.71,0:22:35.83,优酷剧集英语,,0,0,0,,庄宅牙行
Dialogue: 0,0:22:43.00,0:22:44.11,优酷剧集英语,,0,0,0,,好容易轮到咱了
Dialogue: 0,0:22:44.11,0:22:45.35,优酷剧集英语,,0,0,0,,怎么还没轮到我们呀
Dialogue: 0,0:22:46.00,0:22:47.31,优酷剧集英语,,0,0,0,,要见黄行老
Dialogue: 0,0:22:47.35,0:22:48.68,优酷剧集英语,,0,0,0,,就得豁出时间等
Dialogue: 0,0:22:49.71,0:22:51.95,优酷剧集英语,,0,0,0,,你可留心了 别有什么遗漏
Dialogue: 0,0:22:51.95,0:22:53.04,优酷剧集英语,,0,0,0,,放心吧
Dialogue: 0,0:23:12.52,0:23:13.47,优酷剧集英语,,0,0,0,,二位慢走啊
Dialogue: 0,0:23:15.04,0:23:16.43,优酷剧集英语,,0,0,0,,再来啊 常来常来
Dialogue: 0,0:23:16.43,0:23:17.52,优酷剧集英语,,0,0,0,,告辞告辞
Dialogue: 0,0:23:20.64,0:23:21.47,优酷剧集英语,,0,0,0,,这位郎君
Dialogue: 0,0:23:22.19,0:23:23.59,优酷剧集英语,,0,0,0,,别再往前走了
Dialogue: 0,0:23:25.31,0:23:25.83,优酷剧集英语,,0,0,0,,我是来找人的
Dialogue: 0,0:23:25.83,0:23:26.19,优酷剧集英语,,0,0,0,,墨兄
Dialogue: 0,0:23:27.19,0:23:28.00,优酷剧集英语,,0,0,0,,我来了
Dialogue: 0,0:23:30.80,0:23:33.43,优酷剧集英语,,0,0,0,,掌柜 这就是我文章里的事主
Dialogue: 0,0:23:33.83,0:23:35.04,优酷剧集英语,,0,0,0,,我朋友
Dialogue: 0,0:23:36.92,0:23:37.76,优酷剧集英语,,0,0,0,,快点啊
Dialogue: 0,0:23:38.35,0:23:39.92,优酷剧集英语,,0,0,0,,掌柜放心 马上交
Dialogue: 0,0:23:42.16,0:23:43.23,优酷剧集英语,,0,0,0,,你来得真是时候
Dialogue: 0,0:23:43.52,0:23:45.52,优酷剧集英语,,0,0,0,,今天的小报刚刚印好 走 来
Dialogue: 0,0:23:48.56,0:23:50.56,优酷剧集英语,,0,0,0,,寅九李
Dialogue: 0,0:23:51.35,0:23:53.47,优酷剧集英语,,0,0,0,,卯五师
Dialogue: 0,0:23:54.07,0:23:56.04,优酷剧集英语,,0,0,0,,卯五师
Dialogue: 0,0:24:11.16,0:24:12.19,优酷剧集英语,,0,0,0,,你看
Dialogue: 0,0:24:21.16,0:24:22.35,优酷剧集英语,,0,0,0,,少年英杰
Dialogue: 0,0:24:22.59,0:24:24.64,优酷剧集英语,,0,0,0,,勘破天竺幻术
Dialogue: 0,0:24:25.04,0:24:27.68,优酷剧集英语,,0,0,0,,天工破案 大道薪火相传
Dialogue: 0,0:24:28.07,0:24:28.59,优酷剧集英语,,0,0,0,,这
Dialogue: 0,0:24:30.35,0:24:32.40,优酷剧集英语,,0,0,0,,这会不会太夸张了
Dialogue: 0,0:24:32.92,0:24:35.04,优酷剧集英语,,0,0,0,,墨兄 谦虚了
Dialogue: 0,0:24:35.23,0:24:36.80,优酷剧集英语,,0,0,0,,那日你在汴河岸边
Dialogue: 0,0:24:36.80,0:24:38.04,优酷剧集英语,,0,0,0,,只是小露身手
Dialogue: 0,0:24:38.76,0:24:40.59,优酷剧集英语,,0,0,0,,就帮官府破了这桩谜案
Dialogue: 0,0:24:41.16,0:24:42.52,优酷剧集英语,,0,0,0,,这批是刚刚印好的
Dialogue: 0,0:24:42.52,0:24:44.16,优酷剧集英语,,0,0,0,,以你这样的少年英杰
Dialogue: 0,0:24:44.28,0:24:45.47,优酷剧集英语,,0,0,0,,到时候发往全城
Dialogue: 0,0:24:45.56,0:24:46.80,优酷剧集英语,,0,0,0,,所有人就都知道你了
Dialogue: 0,0:24:46.80,0:24:47.59,优酷剧集英语,,0,0,0,,等等
Dialogue: 0,0:24:49.11,0:24:49.95,优酷剧集英语,,0,0,0,,这是什么
Dialogue: 0,0:24:50.35,0:24:51.07,优酷剧集英语,,0,0,0,,苦灰呀
Dialogue: 0,0:24:51.28,0:24:52.31,优酷剧集英语,,0,0,0,,是苦土
Dialogue: 0,0:24:52.59,0:24:53.71,优酷剧集英语,,0,0,0,,你写错了
Dialogue: 0,0:24:54.64,0:24:55.43,优酷剧集英语,,0,0,0,,抱歉
Dialogue: 0,0:24:55.71,0:24:56.59,优酷剧集英语,,0,0,0,,不过
Dialogue: 0,0:24:56.76,0:24:58.71,优酷剧集英语,,0,0,0,,应该也没有什么人认识这个东西
Dialogue: 0,0:24:59.00,0:25:01.11,优酷剧集英语,,0,0,0,,所以大家也只是看个故事
Dialogue: 0,0:25:01.11,0:25:02.35,优酷剧集英语,,0,0,0,,这是格物之理
Dialogue: 0,0:25:03.35,0:25:04.52,优酷剧集英语,,0,0,0,,分毫都不能差
Dialogue: 0,0:25:07.76,0:25:08.19,优酷剧集英语,,0,0,0,,掌柜
Dialogue: 0,0:25:08.19,0:25:08.56,优酷剧集英语,,0,0,0,,墨兄
Dialogue: 0,0:25:08.83,0:25:09.64,优酷剧集英语,,0,0,0,,掌柜
Dialogue: 0,0:25:10.31,0:25:11.11,优酷剧集英语,,0,0,0,,掌柜
Dialogue: 0,0:25:14.35,0:25:16.47,优酷剧集英语,,0,0,0,,这文章中有一个字写错了
Dialogue: 0,0:25:16.47,0:25:17.16,优酷剧集英语,,0,0,0,,要重印
Dialogue: 0,0:25:19.35,0:25:21.16,优酷剧集英语,,0,0,0,,印小报得费多少工夫
Dialogue: 0,0:25:21.23,0:25:22.83,优酷剧集英语,,0,0,0,,谁还有时间给你改字
Dialogue: 0,0:25:25.95,0:25:28.23,优酷剧集英语,,0,0,0,,刚才有个字刻得不好
Dialogue: 0,0:25:33.92,0:25:34.76,优酷剧集英语,,0,0,0,,这个字不行
Dialogue: 0,0:25:34.92,0:25:36.11,优酷剧集英语,,0,0,0,,重新刻 你看看
Dialogue: 0,0:25:36.16,0:25:37.64,优酷剧集英语,,0,0,0,,那笔画都不太对
Dialogue: 0,0:25:40.83,0:25:41.56,优酷剧集英语,,0,0,0,,怎么回事
Dialogue: 0,0:25:42.16,0:25:43.04,优酷剧集英语,,0,0,0,,别给我乱动
Dialogue: 0,0:25:43.04,0:25:43.80,优酷剧集英语,,0,0,0,,你这干吗呢
Dialogue: 0,0:25:45.04,0:25:45.83,优酷剧集英语,,0,0,0,,掌柜的
Dialogue: 0,0:25:46.23,0:25:49.23,优酷剧集英语,,0,0,0,,我能让挑字制版的时间缩短一半
Dialogue: 0,0:25:50.71,0:25:51.52,优酷剧集英语,,0,0,0,,什么意思
Dialogue: 0,0:25:51.80,0:25:52.95,优酷剧集英语,,0,0,0,,但你要答应我
Dialogue: 0,0:25:53.35,0:25:55.43,优酷剧集英语,,0,0,0,,把文中的苦灰改成苦土
Dialogue: 0,0:25:55.59,0:25:57.11,优酷剧集英语,,0,0,0,,我便展示给你看
Dialogue: 0,0:25:57.71,0:25:59.19,优酷剧集英语,,0,0,0,,保证能让你更快制版
Dialogue: 0,0:26:01.31,0:26:02.35,优酷剧集英语,,0,0,0,,这么多年都这么过来的
Dialogue: 0,0:26:02.35,0:26:02.88,优酷剧集英语,,0,0,0,,行
Dialogue: 0,0:26:02.88,0:26:03.59,优酷剧集英语,,0,0,0,,他能缩短
Dialogue: 0,0:26:03.71,0:26:04.71,优酷剧集英语,,0,0,0,,我答应你
Dialogue: 0,0:26:05.00,0:26:05.68,优酷剧集英语,,0,0,0,,宋兄
Dialogue: 0,0:26:06.83,0:26:08.35,优酷剧集英语,,0,0,0,,帮我把常用字拿过来
Dialogue: 0,0:26:23.47,0:26:24.35,优酷剧集英语,,0,0,0,,这是何意啊
Dialogue: 0,0:26:31.11,0:26:31.80,优酷剧集英语,,0,0,0,,唱字
Dialogue: 0,0:26:32.04,0:26:32.59,优酷剧集英语,,0,0,0,,梅
Dialogue: 0,0:26:36.68,0:26:37.56,优酷剧集英语,,0,0,0,,这动起来了
Dialogue: 0,0:26:42.28,0:26:42.76,优酷剧集英语,,0,0,0,,船
Dialogue: 0,0:26:52.71,0:26:54.00,优酷剧集英语,,0,0,0,,真厉害啊
Dialogue: 0,0:26:58.16,0:27:00.80,优酷剧集英语,,0,0,0,,只需按照规律把木雕字
Dialogue: 0,0:27:00.80,0:27:01.88,优酷剧集英语,,0,0,0,,放置于圆盘
Dialogue: 0,0:27:01.88,0:27:03.64,优酷剧集英语,,0,0,0,,转动圆盘即可挑字
Dialogue: 0,0:27:03.88,0:27:05.71,优酷剧集英语,,0,0,0,,原本四五个人干的活儿
Dialogue: 0,0:27:05.83,0:27:07.16,优酷剧集英语,,0,0,0,,只需要两个人便可
Dialogue: 0,0:27:07.19,0:27:08.43,优酷剧集英语,,0,0,0,,这真是个好法子呀
Dialogue: 0,0:27:08.76,0:27:10.95,优酷剧集英语,,0,0,0,,聪明 确实是聪明
Dialogue: 0,0:27:11.68,0:27:12.23,优酷剧集英语,,0,0,0,,那这样
Dialogue: 0,0:27:18.43,0:27:19.43,优酷剧集英语,,0,0,0,,请您改字吧
Dialogue: 0,0:27:20.31,0:27:21.56,优酷剧集英语,,0,0,0,,我觉得改不了
Dialogue: 0,0:27:23.28,0:27:24.95,优酷剧集英语,,0,0,0,,改字可以
Dialogue: 0,0:27:25.83,0:27:27.16,优酷剧集英语,,0,0,0,,可这工本费
Dialogue: 0,0:27:27.52,0:27:28.23,优酷剧集英语,,0,0,0,,谁出啊
Dialogue: 0,0:27:28.52,0:27:29.43,优酷剧集英语,,0,0,0,,你有钱啊
Dialogue: 0,0:27:29.43,0:27:30.95,优酷剧集英语,,0,0,0,,你这不是耍赖吗
Dialogue: 0,0:27:30.95,0:27:31.47,优酷剧集英语,,0,0,0,,掌柜
Dialogue: 0,0:27:31.47,0:27:34.35,优酷剧集英语,,0,0,0,,墨兄不是已经为你省了很多钱吗
Dialogue: 0,0:27:35.43,0:27:37.76,优酷剧集英语,,0,0,0,,是啊 他还给我省了人工呢
Dialogue: 0,0:27:37.92,0:27:39.71,优酷剧集英语,,0,0,0,,以后你不用制版了
Dialogue: 0,0:27:39.95,0:27:40.88,优酷剧集英语,,0,0,0,,工钱减半
Dialogue: 0,0:27:42.07,0:27:42.64,优酷剧集英语,,0,0,0,,你们俩
Dialogue: 0,0:27:42.64,0:27:43.56,优酷剧集英语,,0,0,0,,把他给我推出去
Dialogue: 0,0:27:43.56,0:27:45.07,优酷剧集英语,,0,0,0,,掌柜的 这是你答应我的
Dialogue: 0,0:27:45.07,0:27:46.16,优酷剧集英语,,0,0,0,,你怎么能耍赖呢
Dialogue: 0,0:27:46.31,0:27:47.28,优酷剧集英语,,0,0,0,,若是不改正确
Dialogue: 0,0:27:47.28,0:27:48.52,优酷剧集英语,,0,0,0,,这小报宁可不发
Dialogue: 0,0:27:48.88,0:27:49.83,优酷剧集英语,,0,0,0,,得多干多少活儿
Dialogue: 0,0:27:49.95,0:27:50.52,优酷剧集英语,,0,0,0,,出去
Dialogue: 0,0:27:52.43,0:27:53.88,优酷剧集英语,,0,0,0,,小报虽是消遣
Dialogue: 0,0:27:53.88,0:27:55.07,优酷剧集英语,,0,0,0,,但也不可儿戏
Dialogue: 0,0:27:59.92,0:28:00.59,优酷剧集英语,,0,0,0,,墨兄
Dialogue: 0,0:28:00.68,0:28:01.80,优酷剧集英语,,0,0,0,,走吧走吧 进去吧
Dialogue: 0,0:28:08.16,0:28:08.71,优酷剧集英语,,0,0,0,,小哥
Dialogue: 0,0:28:09.31,0:28:10.19,优酷剧集英语,,0,0,0,,请问那个
Dialogue: 0,0:28:10.28,0:28:11.59,优酷剧集英语,,0,0,0,,行老还在上面吧
Dialogue: 0,0:28:11.59,0:28:12.19,优酷剧集英语,,0,0,0,,还在
Dialogue: 0,0:28:12.28,0:28:13.47,优酷剧集英语,,0,0,0,,好 谢谢啊
Dialogue: 0,0:28:16.56,0:28:18.28,优酷剧集英语,,0,0,0,,大夫要不换个人吧
Dialogue: 0,0:28:20.16,0:28:21.92,优酷剧集英语,,0,0,0,,我本来只是手臂酸痛
Dialogue: 0,0:28:22.23,0:28:23.80,优酷剧集英语,,0,0,0,,现在感觉全身都要断了
Dialogue: 0,0:28:23.92,0:28:25.47,优酷剧集英语,,0,0,0,,您担待点 担待点
Dialogue: 0,0:28:25.47,0:28:26.92,优酷剧集英语,,0,0,0,,我这个学徒啊
Dialogue: 0,0:28:27.11,0:28:29.28,优酷剧集英语,,0,0,0,,她既能干又好学
Dialogue: 0,0:28:29.28,0:28:30.71,优酷剧集英语,,0,0,0,,就是力气大了一点
Dialogue: 0,0:28:31.56,0:28:32.28,优酷剧集英语,,0,0,0,,女侠饶命
Dialogue: 0,0:28:32.28,0:28:32.95,优酷剧集英语,,0,0,0,,女侠饶命
Dialogue: 0,0:28:32.95,0:28:33.43,优酷剧集英语,,0,0,0,,瓣儿
Dialogue: 0,0:28:34.04,0:28:34.59,优酷剧集英语,,0,0,0,,松手
Dialogue: 0,0:28:42.00,0:28:43.43,优酷剧集英语,,0,0,0,,葛大夫您这是
Dialogue: 0,0:28:43.43,0:28:44.83,优酷剧集英语,,0,0,0,,你干了半天了
Dialogue: 0,0:28:44.92,0:28:46.43,优酷剧集英语,,0,0,0,,也不能让你白干啊
Dialogue: 0,0:28:46.76,0:28:49.47,优酷剧集英语,,0,0,0,,毕竟啊付出了不少力气
Dialogue: 0,0:28:49.68,0:28:51.95,优酷剧集英语,,0,0,0,,不过 这个从医啊
Dialogue: 0,0:28:51.95,0:28:53.35,优酷剧集英语,,0,0,0,,讲究的是天分
Dialogue: 0,0:28:54.07,0:28:55.35,优酷剧集英语,,0,0,0,,你没这个天分
Dialogue: 0,0:28:56.07,0:28:56.64,优酷剧集英语,,0,0,0,,走吧
Dialogue: 0,0:28:57.43,0:28:58.28,优酷剧集英语,,0,0,0,,走吧
Dialogue: 0,0:29:17.40,0:29:18.07,优酷剧集英语,,0,0,0,,请问
Dialogue: 0,0:29:18.43,0:29:20.71,优酷剧集英语,,0,0,0,,行老什么时候能见我啊
Dialogue: 0,0:29:21.76,0:29:23.35,优酷剧集英语,,0,0,0,,行老早就回去了
Dialogue: 0,0:29:23.71,0:29:24.88,优酷剧集英语,,0,0,0,,他走了
Dialogue: 0,0:29:26.15,0:29:28.39,优酷剧集英语,,0,0,0,,我 我在这里等了一天了
Dialogue: 0,0:29:28.39,0:29:30.04,优酷剧集英语,,0,0,0,,他走怎么不跟我说一声啊
Dialogue: 0,0:29:30.23,0:29:32.00,优酷剧集英语,,0,0,0,,我们行老日理万机
Dialogue: 0,0:29:32.31,0:29:34.19,优酷剧集英语,,0,0,0,,你谁啊 还得给你说
Dialogue: 0,0:29:39.52,0:29:40.95,优酷剧集英语,,0,0,0,,这个不着调的
Dialogue: 0,0:29:41.40,0:29:42.80,优酷剧集英语,,0,0,0,,怎么还不来啊
Dialogue: 0,0:29:46.04,0:29:47.64,优酷剧集英语,,0,0,0,,骑驴看房子是免费的
Dialogue: 0,0:29:47.64,0:29:49.23,优酷剧集英语,,0,0,0,,我们甜水巷坐北朝南
Dialogue: 0,0:29:49.23,0:29:50.11,优酷剧集英语,,0,0,0,,南北通透
Dialogue: 0,0:29:50.11,0:29:51.23,优酷剧集英语,,0,0,0,,中间还有个大池塘
Dialogue: 0,0:29:51.23,0:29:53.04,优酷剧集英语,,0,0,0,,北边紧临大相国寺
Dialogue: 0,0:29:53.16,0:29:54.43,优酷剧集英语,,0,0,0,,我静悄悄告诉二位
Dialogue: 0,0:29:54.43,0:29:55.16,优酷剧集英语,,0,0,0,,这座宅子
Dialogue: 0,0:29:55.16,0:29:56.83,优酷剧集英语,,0,0,0,,达官贵人们住的
Dialogue: 0,0:30:03.64,0:30:06.00,优酷剧集英语,,0,0,0,,要置宅了 你高兴点
Dialogue: 0,0:30:07.31,0:30:08.28,优酷剧集英语,,0,0,0,,你高兴吗
Dialogue: 0,0:30:08.31,0:30:09.35,优酷剧集英语,,0,0,0,,那你怎么不笑啊
Dialogue: 0,0:30:09.64,0:30:10.68,优酷剧集英语,,0,0,0,,你也有心事
Dialogue: 0,0:30:24.52,0:30:25.07,优酷剧集英语,,0,0,0,,你找谁
Dialogue: 0,0:30:31.11,0:30:31.71,优酷剧集英语,,0,0,0,,你扔什么呀
Dialogue: 0,0:30:51.28,0:30:51.76,优酷剧集英语,,0,0,0,,嫂子
Dialogue: 0,0:30:51.83,0:30:52.47,优酷剧集英语,,0,0,0,,嫂子
Dialogue: 0,0:30:52.47,0:30:53.16,优酷剧集英语,,0,0,0,,嫂子
Dialogue: 0,0:30:54.11,0:30:55.19,优酷剧集英语,,0,0,0,,你们俩大哥呢
Dialogue: 0,0:30:55.31,0:30:56.40,优酷剧集英语,,0,0,0,,大哥还没来呢
Dialogue: 0,0:30:57.88,0:30:58.76,优酷剧集英语,,0,0,0,,那不等他了
Dialogue: 0,0:30:58.76,0:30:59.83,优酷剧集英语,,0,0,0,,咱们先办正事
Dialogue: 0,0:31:02.31,0:31:03.07,优酷剧集英语,,0,0,0,,这位客
Dialogue: 0,0:31:04.71,0:31:05.43,优酷剧集英语,,0,0,0,,温娘子
Dialogue: 0,0:31:06.68,0:31:08.11,优酷剧集英语,,0,0,0,,您又来看房了
Dialogue: 0,0:31:08.11,0:31:10.52,优酷剧集英语,,0,0,0,,这都看了快一年了 还看
Dialogue: 0,0:31:11.28,0:31:12.11,优酷剧集英语,,0,0,0,,我今天
Dialogue: 0,0:31:12.11,0:31:13.31,优酷剧集英语,,0,0,0,,是来交定钱的
Dialogue: 0,0:31:13.52,0:31:15.00,优酷剧集英语,,0,0,0,,麦秸巷那套房子
Dialogue: 0,0:31:15.00,0:31:15.88,优酷剧集英语,,0,0,0,,今天就买了
Dialogue: 0,0:31:20.00,0:31:22.40,优酷剧集英语,,0,0,0,,得嘞 这就给您拟契书去
Dialogue: 0,0:31:32.52,0:31:34.43,优酷剧集英语,,0,0,0,,做我们这行有个规矩
Dialogue: 0,0:31:34.92,0:31:37.16,优酷剧集英语,,0,0,0,,如果发单人不想露面的话
Dialogue: 0,0:31:37.40,0:31:40.07,优酷剧集英语,,0,0,0,,就在包袱皮上写个匕字
Dialogue: 0,0:31:49.64,0:31:52.00,优酷剧集英语,,0,0,0,,限五日内杀章七娘
Dialogue: 0,0:31:52.00,0:31:54.43,优酷剧集英语,,0,0,0,,酬金一百两黄金
Dialogue: 0,0:31:55.00,0:31:56.28,优酷剧集英语,,0,0,0,,如若不从
Dialogue: 0,0:31:56.52,0:31:58.07,优酷剧集英语,,0,0,0,,杀你全家
Dialogue: 0,0:32:03.47,0:32:04.23,优酷剧集英语,,0,0,0,,让开
Dialogue: 0,0:32:05.88,0:32:06.80,优酷剧集英语,,0,0,0,,让开 让开
Dialogue: 0,0:32:08.11,0:32:08.88,优酷剧集英语,,0,0,0,,让开
Dialogue: 0,0:32:09.71,0:32:10.47,优酷剧集英语,,0,0,0,,让开
Dialogue: 0,0:32:10.47,0:32:11.43,优酷剧集英语,,0,0,0,,来 让开让开
Dialogue: 0,0:32:11.43,0:32:12.43,优酷剧集英语,,0,0,0,,让开让开
Dialogue: 0,0:32:12.95,0:32:13.64,优酷剧集英语,,0,0,0,,让开
Dialogue: 0,0:32:14.68,0:32:15.35,优酷剧集英语,,0,0,0,,让开
Dialogue: 0,0:32:17.68,0:32:18.47,优酷剧集英语,,0,0,0,,这这这
Dialogue: 0,0:32:18.76,0:32:19.47,优酷剧集英语,,0,0,0,,快过来 快
Dialogue: 0,0:32:19.68,0:32:20.19,优酷剧集英语,,0,0,0,,嫂子
Dialogue: 0,0:32:21.07,0:32:22.04,优酷剧集英语,,0,0,0,,没事吧你
Dialogue: 0,0:32:31.80,0:32:33.00,优酷剧集英语,,0,0,0,,章七娘子有礼
Dialogue: 0,0:32:33.64,0:32:34.83,优酷剧集英语,,0,0,0,,您有什么吩咐
Dialogue: 0,0:32:35.07,0:32:36.07,优酷剧集英语,,0,0,0,,老规矩
Dialogue: 0,0:32:36.07,0:32:36.76,优酷剧集英语,,0,0,0,,章七娘
Dialogue: 0,0:32:36.83,0:32:39.59,优酷剧集英语,,0,0,0,,来你这儿看看最近有什么好货
Dialogue: 0,0:32:40.47,0:32:41.71,优酷剧集英语,,0,0,0,,顺便问一嘴
Dialogue: 0,0:32:42.40,0:32:44.59,优酷剧集英语,,0,0,0,,我交给你的那些宅院
Dialogue: 0,0:32:45.43,0:32:47.68,优酷剧集英语,,0,0,0,,为何迟迟未能成交啊
Dialogue: 0,0:32:49.35,0:32:51.43,优酷剧集英语,,0,0,0,,其实本来成交了几笔
Dialogue: 0,0:32:51.88,0:32:53.43,优酷剧集英语,,0,0,0,,但是最近有些传言
Dialogue: 0,0:32:53.80,0:32:56.83,优酷剧集英语,,0,0,0,,说杨楼街那片又开始闹帽妖了
Dialogue: 0,0:32:57.28,0:32:58.56,优酷剧集英语,,0,0,0,,一派胡言
Dialogue: 0,0:33:10.31,0:33:12.64,优酷剧集英语,,0,0,0,,把那些牙人都给我叫过来
Dialogue: 0,0:33:13.43,0:33:15.47,优酷剧集英语,,0,0,0,,我今天倒要查清楚
Dialogue: 0,0:33:16.16,0:33:19.23,优酷剧集英语,,0,0,0,,到底是谁在私底下传谣
Dialogue: 0,0:33:24.80,0:33:25.56,优酷剧集英语,,0,0,0,,七娘子
Dialogue: 0,0:33:26.28,0:33:27.56,优酷剧集英语,,0,0,0,,潘家吉院
Dialogue: 0,0:33:28.16,0:33:30.23,优酷剧集英语,,0,0,0,,您看看这东华门街的潘家吉院
Dialogue: 0,0:33:30.35,0:33:31.95,优酷剧集英语,,0,0,0,,这二楼往南看
Dialogue: 0,0:33:31.95,0:33:34.16,优酷剧集英语,,0,0,0,,能看到半个东京城的风光
Dialogue: 0,0:33:34.35,0:33:37.80,优酷剧集英语,,0,0,0,,这视野在全东京那可是独一份啊
Dialogue: 0,0:33:39.28,0:33:40.19,优酷剧集英语,,0,0,0,,梁家大院
Dialogue: 0,0:33:41.04,0:33:42.64,优酷剧集英语,,0,0,0,,北苑大街 梁家大院
Dialogue: 0,0:33:42.64,0:33:44.56,优酷剧集英语,,0,0,0,,是东京最大的府邸之一
Dialogue: 0,0:33:45.23,0:33:47.47,优酷剧集英语,,0,0,0,,顶平常人家三四个院落大呢
Dialogue: 0,0:33:47.47,0:33:49.71,优酷剧集英语,,0,0,0,,林家大院也是顶好的宅
Dialogue: 0,0:33:50.04,0:33:52.80,优酷剧集英语,,0,0,0,,别看它的屋宅院落比梁家大院小
Dialogue: 0,0:33:53.47,0:33:54.11,优酷剧集英语,,0,0,0,,但是啊
Dialogue: 0,0:33:54.35,0:33:55.52,优酷剧集英语,,0,0,0,,您可知道它的位置
Dialogue: 0,0:33:55.52,0:33:56.40,优酷剧集英语,,0,0,0,,这女子谁啊
Dialogue: 0,0:33:56.40,0:33:57.35,优酷剧集英语,,0,0,0,,这么有钱啊
Dialogue: 0,0:33:58.19,0:33:59.88,优酷剧集英语,,0,0,0,,鼎鼎大名的章七娘啊
Dialogue: 0,0:34:00.11,0:34:01.28,优酷剧集英语,,0,0,0,,这小半个东京城啊
Dialogue: 0,0:34:01.28,0:34:02.11,优酷剧集英语,,0,0,0,,可都是她的
Dialogue: 0,0:34:02.11,0:34:04.40,优酷剧集英语,,0,0,0,,我们在这儿等签契书等半天了
Dialogue: 0,0:34:04.59,0:34:06.16,优酷剧集英语,,0,0,0,,何时给我们笔墨呀
Dialogue: 0,0:34:06.16,0:34:07.35,优酷剧集英语,,0,0,0,,同样都是客人
Dialogue: 0,0:34:07.35,0:34:08.36,优酷剧集英语,,0,0,0,,厚此薄彼
Dialogue: 0,0:34:08.36,0:34:09.47,优酷剧集英语,,0,0,0,,这不合规矩
Dialogue: 0,0:34:10.36,0:34:12.36,优酷剧集英语,,0,0,0,,规矩不也是银钱定的吗
Dialogue: 0,0:34:12.36,0:34:13.19,优酷剧集英语,,0,0,0,,抱歉
Dialogue: 0,0:34:13.19,0:34:14.00,优酷剧集英语,,0,0,0,,那明明是我们先来的
Dialogue: 0,0:34:14.00,0:34:15.28,优酷剧集英语,,0,0,0,,这谁家的小娘子啊
Dialogue: 0,0:34:15.80,0:34:17.19,优酷剧集英语,,0,0,0,,你是不是有意见
Dialogue: 0,0:34:19.87,0:34:21.95,优酷剧集英语,,0,0,0,,我弟弟妹妹说话是急了些
Dialogue: 0,0:34:22.36,0:34:23.36,优酷剧集英语,,0,0,0,,但是在理
Dialogue: 0,0:34:23.43,0:34:25.95,优酷剧集英语,,0,0,0,,先来后到是最基本的规矩吧
Dialogue: 0,0:34:26.23,0:34:27.23,优酷剧集英语,,0,0,0,,规矩
Dialogue: 0,0:34:27.67,0:34:30.56,优酷剧集英语,,0,0,0,,是用来约束你们这些普通人的
Dialogue: 0,0:34:30.56,0:34:32.04,优酷剧集英语,,0,0,0,,有钱了不起啊
Dialogue: 0,0:34:35.19,0:34:37.28,优酷剧集英语,,0,0,0,,你们仨是一家子的吧
Dialogue: 0,0:34:38.23,0:34:39.63,优酷剧集英语,,0,0,0,,也是来置产的
Dialogue: 0,0:34:40.67,0:34:41.63,优酷剧集英语,,0,0,0,,进来啊
Dialogue: 0,0:34:42.36,0:34:45.71,优酷剧集英语,,0,0,0,,来看看你们是看上哪些宅子了
Dialogue: 0,0:34:49.56,0:34:50.23,优酷剧集英语,,0,0,0,,他们看上了
Dialogue: 0,0:34:50.23,0:34:51.43,优酷剧集英语,,0,0,0,,麦秸巷那间
Dialogue: 0,0:34:53.95,0:34:56.08,优酷剧集英语,,0,0,0,,这小宅子确实是不错啊
Dialogue: 0,0:34:56.36,0:34:57.95,优酷剧集英语,,0,0,0,,眼光品位
Dialogue: 0,0:34:58.63,0:34:59.95,优酷剧集英语,,0,0,0,,仅次于我
Dialogue: 0,0:35:00.63,0:35:01.60,优酷剧集英语,,0,0,0,,七娘子
Dialogue: 0,0:35:01.95,0:35:02.95,优酷剧集英语,,0,0,0,,您有兴趣
Dialogue: 0,0:35:03.63,0:35:05.63,优酷剧集英语,,0,0,0,,麦秸巷里所有的宅子
Dialogue: 0,0:35:06.15,0:35:07.56,优酷剧集英语,,0,0,0,,我全都要了
Dialogue: 0,0:35:08.47,0:35:09.28,优酷剧集英语,,0,0,0,,慢着
Dialogue: 0,0:35:10.80,0:35:13.00,优酷剧集英语,,0,0,0,,麦秸巷的房子你随便挑
Dialogue: 0,0:35:13.47,0:35:16.00,优酷剧集英语,,0,0,0,,但是这一套 我已经付了定钱
Dialogue: 0,0:35:16.56,0:35:17.56,优酷剧集英语,,0,0,0,,定钱呢
Dialogue: 0,0:35:18.28,0:35:19.08,优酷剧集英语,,0,0,0,,在我这儿
Dialogue: 0,0:35:20.39,0:35:21.67,优酷剧集英语,,0,0,0,,那契书呢
Dialogue: 0,0:35:22.04,0:35:26.19,优酷剧集英语,,0,0,0,,这契书白纸黑字写着我的名字
Dialogue: 0,0:35:26.95,0:35:29.00,优酷剧集英语,,0,0,0,,定钱我也已经付了
Dialogue: 0,0:35:29.39,0:35:31.56,优酷剧集英语,,0,0,0,,这套房子是我们的了
Dialogue: 0,0:35:33.36,0:35:35.67,优酷剧集英语,,0,0,0,,麻烦拿笔墨 我画押
Dialogue: 0,0:35:46.00,0:35:48.23,优酷剧集英语,,0,0,0,,温娘子 你请签吧
Dialogue: 0,0:35:52.12,0:35:54.67,优酷剧集英语,,0,0,0,,嫂子 咱们终于置上宅了
Dialogue: 0,0:35:56.12,0:35:57.87,优酷剧集英语,,0,0,0,,这一年来辛苦你了
Dialogue: 0,0:35:58.00,0:36:00.12,优酷剧集英语,,0,0,0,,温娘子 定金是齐了
Dialogue: 0,0:36:00.12,0:36:02.80,优酷剧集英语,,0,0,0,,这后续的银钱您是从解库贷
Dialogue: 0,0:36:03.80,0:36:05.63,优酷剧集英语,,0,0,0,,我们从解库贷一些
Dialogue: 0,0:36:05.84,0:36:07.00,优酷剧集英语,,0,0,0,,尽快交上
Dialogue: 0,0:36:07.19,0:36:08.91,优酷剧集英语,,0,0,0,,为了这么个小宅子
Dialogue: 0,0:36:09.32,0:36:12.00,优酷剧集英语,,0,0,0,,背上解库十年八年的债
Dialogue: 0,0:36:12.00,0:36:12.87,优酷剧集英语,,0,0,0,,值得吗
Dialogue: 0,0:36:13.52,0:36:16.04,优酷剧集英语,,0,0,0,,谁说我们十年八年才能还得上
Dialogue: 0,0:36:17.19,0:36:18.32,优酷剧集英语,,0,0,0,,可惜了
Dialogue: 0,0:36:18.63,0:36:20.63,优酷剧集英语,,0,0,0,,哪怕你三五年就还上
Dialogue: 0,0:36:21.23,0:36:22.84,优酷剧集英语,,0,0,0,,现在也来不及了
Dialogue: 0,0:36:24.00,0:36:25.23,优酷剧集英语,,0,0,0,,因为解库
Dialogue: 0,0:36:26.80,0:36:28.32,优酷剧集英语,,0,0,0,,就是我开的
Dialogue: 0,0:36:31.52,0:36:33.84,优酷剧集英语,,0,0,0,,这东京城的解库多了去了
Dialogue: 0,0:36:34.39,0:36:36.00,优酷剧集英语,,0,0,0,,我们换一家就是了
Dialogue: 0,0:36:37.19,0:36:38.87,优酷剧集英语,,0,0,0,,全东京的解库
Dialogue: 0,0:36:39.19,0:36:40.19,优酷剧集英语,,0,0,0,,要么姓章
Dialogue: 0,0:36:40.32,0:36:43.04,优酷剧集英语,,0,0,0,,要么跟章家都沾亲带故
Dialogue: 0,0:36:43.71,0:36:46.95,优酷剧集英语,,0,0,0,,温娘子 交不上尾金可不行
Dialogue: 0,0:36:48.00,0:36:49.19,优酷剧集英语,,0,0,0,,签了契书
Dialogue: 0,0:36:49.60,0:36:51.63,优酷剧集英语,,0,0,0,,若不能如数交上尾金
Dialogue: 0,0:36:52.00,0:36:53.91,优酷剧集英语,,0,0,0,,这契书可就作废了
Dialogue: 0,0:36:54.47,0:36:58.04,优酷剧集英语,,0,0,0,,而且牙行是不退还定金的
Dialogue: 0,0:36:59.80,0:37:03.00,优酷剧集英语,,0,0,0,,这东京城的豪宅良田多得是
Dialogue: 0,0:37:03.84,0:37:04.91,优酷剧集英语,,0,0,0,,为什么偏偏
Dialogue: 0,0:37:04.91,0:37:07.19,优酷剧集英语,,0,0,0,,跟我们这些普通百姓过不去呢
Dialogue: 0,0:37:08.71,0:37:09.67,优酷剧集英语,,0,0,0,,要不这样
Dialogue: 0,0:37:10.28,0:37:12.60,优酷剧集英语,,0,0,0,,我跟牙行行首相熟
Dialogue: 0,0:37:13.12,0:37:14.67,优酷剧集英语,,0,0,0,,我帮你跟他说说
Dialogue: 0,0:37:15.19,0:37:17.84,优酷剧集英语,,0,0,0,,把你的定金退还给你
Dialogue: 0,0:37:22.84,0:37:24.56,优酷剧集英语,,0,0,0,,麦秸巷所有宅子
Dialogue: 0,0:37:25.19,0:37:26.71,优酷剧集英语,,0,0,0,,拟好契书
Dialogue: 0,0:37:27.12,0:37:29.19,优酷剧集英语,,0,0,0,,来章府结钱
Dialogue: 0,0:37:36.76,0:37:37.56,优酷剧集英语,,0,0,0,,嫂子
Dialogue: 0,0:37:38.84,0:37:39.63,优酷剧集英语,,0,0,0,,嫂子
Dialogue: 0,0:37:40.04,0:37:41.47,优酷剧集英语,,0,0,0,,你别生气啊
Dialogue: 0,0:37:44.63,0:37:46.47,优酷剧集英语,,0,0,0,,温娘子 对不住了
Dialogue: 0,0:38:02.12,0:38:02.91,优酷剧集英语,,0,0,0,,回家
Dialogue: 0,0:38:08.87,0:38:09.67,优酷剧集英语,,0,0,0,,嫂子
Dialogue: 0,0:38:09.95,0:38:12.39,优酷剧集英语,,0,0,0,,你还在为昨天置宅的事难过呢
Dialogue: 0,0:38:12.87,0:38:15.32,优酷剧集英语,,0,0,0,,我倒没事 只是你大哥
Dialogue: 0,0:38:15.32,0:38:17.52,优酷剧集英语,,0,0,0,,是啊 我也觉得大哥怪怪的
Dialogue: 0,0:38:17.52,0:38:19.12,优酷剧集英语,,0,0,0,,昨天不但没去牙行
Dialogue: 0,0:38:19.12,0:38:20.23,优酷剧集英语,,0,0,0,,咱们回来的时候
Dialogue: 0,0:38:20.23,0:38:22.15,优酷剧集英语,,0,0,0,,他还一副魂不守舍的样子
Dialogue: 0,0:38:22.15,0:38:23.08,优酷剧集英语,,0,0,0,,一惊一乍的
Dialogue: 0,0:38:23.43,0:38:24.71,优酷剧集英语,,0,0,0,,怕不是得了痹症
Dialogue: 0,0:38:30.39,0:38:31.00,优酷剧集英语,,0,0,0,,瓣儿
Dialogue: 0,0:38:31.43,0:38:33.84,优酷剧集英语,,0,0,0,,嫂子一直相信你的医术
Dialogue: 0,0:38:34.00,0:38:36.43,优酷剧集英语,,0,0,0,,一会儿啊好好给你大哥扎两针
Dialogue: 0,0:38:39.12,0:38:39.63,优酷剧集英语,,0,0,0,,走
Dialogue: 0,0:38:40.00,0:38:41.08,优酷剧集英语,,0,0,0,,我好了
Dialogue: 0,0:38:41.08,0:38:42.39,优酷剧集英语,,0,0,0,,谢谢娘子的关心
Dialogue: 0,0:38:43.84,0:38:45.91,优酷剧集英语,,0,0,0,,不用瓣儿再给你放放血啊
Dialogue: 0,0:38:45.91,0:38:47.32,优酷剧集英语,,0,0,0,,不用 我吃早饭
Dialogue: 0,0:38:48.52,0:38:49.63,优酷剧集英语,,0,0,0,,我最喜欢的煎肠
Dialogue: 0,0:38:49.63,0:38:50.23,优酷剧集英语,,0,0,0,,不能吃
Dialogue: 0,0:38:50.47,0:38:52.52,优酷剧集英语,,0,0,0,,得了痹症不能吃任何内脏
Dialogue: 0,0:38:53.71,0:38:54.36,优酷剧集英语,,0,0,0,,是吗
Dialogue: 0,0:38:54.91,0:38:55.56,优酷剧集英语,,0,0,0,,但没关系
Dialogue: 0,0:38:55.56,0:38:56.67,优酷剧集英语,,0,0,0,,我能治好你
Dialogue: 0,0:38:56.67,0:38:57.32,优酷剧集英语,,0,0,0,,放血
Dialogue: 0,0:38:57.52,0:38:58.63,优酷剧集英语,,0,0,0,,放了血就好了
Dialogue: 0,0:38:59.08,0:39:00.47,优酷剧集英语,,0,0,0,,你大哥这病啊
Dialogue: 0,0:39:00.47,0:39:01.60,优酷剧集英语,,0,0,0,,可舍不得治
Dialogue: 0,0:39:01.95,0:39:03.04,优酷剧集英语,,0,0,0,,留着解闷的
Dialogue: 0,0:39:06.00,0:39:08.91,优酷剧集英语,,0,0,0,,咱们家找了大半年的宅子
Dialogue: 0,0:39:09.19,0:39:10.52,优酷剧集英语,,0,0,0,,眼看就要搬了
Dialogue: 0,0:39:10.87,0:39:12.28,优酷剧集英语,,0,0,0,,结果还是被人抢了
Dialogue: 0,0:39:12.43,0:39:13.56,优酷剧集英语,,0,0,0,,不过没关系啊
Dialogue: 0,0:39:13.84,0:39:15.84,优酷剧集英语,,0,0,0,,大哥我再攒攒钱
Dialogue: 0,0:39:15.84,0:39:18.15,优酷剧集英语,,0,0,0,,以后什么好宅子买不着
Dialogue: 0,0:39:18.43,0:39:18.91,优酷剧集英语,,0,0,0,,对吧
Dialogue: 0,0:39:19.43,0:39:20.39,优酷剧集英语,,0,0,0,,大哥你这话
Dialogue: 0,0:39:20.39,0:39:21.80,优酷剧集英语,,0,0,0,,说得倒是轻巧
Dialogue: 0,0:39:22.87,0:39:24.36,优酷剧集英语,,0,0,0,,看不起你大哥是不是
Dialogue: 0,0:39:24.43,0:39:26.84,优酷剧集英语,,0,0,0,,等我的讼摊支起来以后
Dialogue: 0,0:39:27.08,0:39:29.47,优酷剧集英语,,0,0,0,,这钱还不像流水一样哗哗地来啊
Dialogue: 0,0:39:32.32,0:39:34.67,优酷剧集英语,,0,0,0,,昨天你讼摊的事办得怎么样啊
Dialogue: 0,0:39:36.15,0:39:37.39,优酷剧集英语,,0,0,0,,办好了吗
Dialogue: 0,0:39:37.87,0:39:38.67,优酷剧集英语,,0,0,0,,大夫
Dialogue: 0,0:39:39.32,0:39:40.67,优酷剧集英语,,0,0,0,,这白粥我能喝吗
Dialogue: 0,0:39:41.32,0:39:41.95,优酷剧集英语,,0,0,0,,可以
Dialogue: 0,0:39:43.39,0:39:44.19,优酷剧集英语,,0,0,0,,咱们家
Dialogue: 0,0:39:44.71,0:39:45.63,优酷剧集英语,,0,0,0,,虽然小
Dialogue: 0,0:39:46.23,0:39:47.47,优酷剧集英语,,0,0,0,,虽然旧了一些
Dialogue: 0,0:39:48.43,0:39:50.47,优酷剧集英语,,0,0,0,,但是能一家人团聚在一起
Dialogue: 0,0:39:50.76,0:39:51.63,优酷剧集英语,,0,0,0,,一碗白粥
Dialogue: 0,0:39:52.39,0:39:54.76,优酷剧集英语,,0,0,0,,大哥也觉得这日子过得舒坦
Dialogue: 0,0:39:55.63,0:39:57.04,优酷剧集英语,,0,0,0,,要不是那个章七娘
Dialogue: 0,0:39:57.04,0:39:59.32,优酷剧集英语,,0,0,0,,把我们的麦秸巷的房子买走了
Dialogue: 0,0:39:59.32,0:40:01.67,优酷剧集英语,,0,0,0,,我们都坐在凉台上喝冰梅子酒了
Dialogue: 0,0:40:06.95,0:40:07.80,优酷剧集英语,,0,0,0,,你刚才说
Dialogue: 0,0:40:09.32,0:40:10.32,优酷剧集英语,,0,0,0,,这人叫什么
Dialogue: 0,0:40:10.56,0:40:11.60,优酷剧集英语,,0,0,0,,章七娘
Dialogue: 0,0:40:11.91,0:40:13.71,优酷剧集英语,,0,0,0,,章七娘买了咱们的宅子
Dialogue: 0,0:40:14.19,0:40:15.36,优酷剧集英语,,0,0,0,,你激动什么
Dialogue: 0,0:40:16.00,0:40:16.95,优酷剧集英语,,0,0,0,,你认识她
Dialogue: 0,0:40:19.23,0:40:22.36,优酷剧集英语,,0,0,0,,不 东 东京谁不认识章七娘啊
Dialogue: 0,0:40:33.36,0:40:35.28,优酷剧集英语,,0,0,0,,不好了 出事了
Dialogue: 0,0:40:35.28,0:40:37.32,优酷剧集英语,,0,0,0,,馒头铺的武大郎死了
Dialogue: 0,0:40:38.28,0:40:40.56,优酷剧集英语,,0,0,0,,一个大活人 这样说死就死了
Dialogue: 0,0:40:40.56,0:40:41.80,优酷剧集英语,,0,0,0,,可不是吗
Dialogue: 0,0:40:41.80,0:40:42.67,优酷剧集英语,,0,0,0,,就是啊
Dialogue: 0,0:40:42.67,0:40:44.04,优酷剧集英语,,0,0,0,,昨天还好好的
Dialogue: 0,0:40:44.04,0:40:45.52,优酷剧集英语,,0,0,0,,怎么就死了
Dialogue: 0,0:40:45.84,0:40:46.63,优酷剧集英语,,0,0,0,,兵都来了
Dialogue: 0,0:40:46.63,0:40:47.80,优酷剧集英语,,0,0,0,,肯定是出事了
Dialogue: 0,0:40:48.32,0:40:49.63,优酷剧集英语,,0,0,0,,听说死得可惨了
Dialogue: 0,0:40:49.63,0:40:50.39,优酷剧集英语,,0,0,0,,推司啊
Dialogue: 0,0:40:51.12,0:40:52.28,优酷剧集英语,,0,0,0,,嫌犯孙勃
Dialogue: 0,0:40:52.60,0:40:53.67,优酷剧集英语,,0,0,0,,死者家属
Dialogue: 0,0:40:53.67,0:40:55.52,优酷剧集英语,,0,0,0,,打更人 证人 都到了
Dialogue: 0,0:40:56.32,0:40:57.28,优酷剧集英语,,0,0,0,,咱们开始吧
Dialogue: 0,0:40:58.08,0:41:01.04,优酷剧集英语,,0,0,0,,你俩把昨天晚上发生的事说一遍
Dialogue: 0,0:41:03.91,0:41:04.63,优酷剧集英语,,0,0,0,,官人
Dialogue: 0,0:41:05.39,0:41:07.08,优酷剧集英语,,0,0,0,,我三妹昨天晚上备菜的时候
Dialogue: 0,0:41:07.08,0:41:07.76,优酷剧集英语,,0,0,0,,烫了手
Dialogue: 0,0:41:08.08,0:41:09.47,优酷剧集英语,,0,0,0,,我便带她去了医馆
Dialogue: 0,0:41:09.91,0:41:11.08,优酷剧集英语,,0,0,0,,回来的路上
Dialogue: 0,0:41:11.47,0:41:12.60,优酷剧集英语,,0,0,0,,遇见了打更的
Dialogue: 0,0:41:12.71,0:41:13.67,优酷剧集英语,,0,0,0,,打更的
Dialogue: 0,0:41:13.76,0:41:14.52,优酷剧集英语,,0,0,0,,在
Dialogue: 0,0:41:15.60,0:41:17.08,优酷剧集英语,,0,0,0,,昨天晚上你看见什么了
Dialogue: 0,0:41:18.04,0:41:19.15,优酷剧集英语,,0,0,0,,禀官人
Dialogue: 0,0:41:19.80,0:41:21.84,优酷剧集英语,,0,0,0,,武娘子说她家里有那个
Dialogue: 0,0:41:21.84,0:41:23.04,优酷剧集英语,,0,0,0,,卖剩的馒头
Dialogue: 0,0:41:23.04,0:41:24.56,优酷剧集英语,,0,0,0,,说是让我拿回去吃
Dialogue: 0,0:41:25.12,0:41:26.71,优酷剧集英语,,0,0,0,,谁知道刚一进门
Dialogue: 0,0:41:28.12,0:41:29.60,优酷剧集英语,,0,0,0,,大哥 我们回来了
Dialogue: 0,0:41:38.04,0:41:39.95,优酷剧集英语,,0,0,0,,大哥
Dialogue: 0,0:41:47.84,0:41:49.08,优酷剧集英语,,0,0,0,,救命啊
Dialogue: 0,0:41:49.08,0:41:50.28,优酷剧集英语,,0,0,0,,闹鬼了
Dialogue: 0,0:41:55.84,0:41:58.32,优酷剧集英语,,0,0,0,,那妖怪噌的一下就扑了过来
Dialogue: 0,0:41:59.00,0:42:00.23,优酷剧集英语,,0,0,0,,那样子就像是
Dialogue: 0,0:42:00.63,0:42:01.84,优酷剧集英语,,0,0,0,,像是一顶帽子
Dialogue: 0,0:42:01.84,0:42:04.00,优酷剧集英语,,0,0,0,,上面沾满了带血的头发
Dialogue: 0,0:42:04.15,0:42:05.04,优酷剧集英语,,0,0,0,,这指不定
Dialogue: 0,0:42:05.52,0:42:07.63,优酷剧集英语,,0,0,0,,这这这 这吸了多少人的头啊
Dialogue: 0,0:42:07.63,0:42:09.23,优酷剧集英语,,0,0,0,,这是传说中的帽妖吧
Dialogue: 0,0:42:10.23,0:42:11.36,优酷剧集英语,,0,0,0,,五年前就在杨楼街这儿
Dialogue: 0,0:42:11.36,0:42:12.04,优酷剧集英语,,0,0,0,,肃静
Dialogue: 0,0:42:12.19,0:42:13.12,优酷剧集英语,,0,0,0,,邪性得很
Dialogue: 0,0:42:13.12,0:42:14.32,优酷剧集英语,,0,0,0,,当时都是传闻
Dialogue: 0,0:42:14.32,0:42:15.60,优酷剧集英语,,0,0,0,,这回真现身了
Dialogue: 0,0:42:15.91,0:42:17.00,优酷剧集英语,,0,0,0,,肃静
Dialogue: 0,0:42:20.71,0:42:22.12,优酷剧集英语,,0,0,0,,苦土
Dialogue: 0,0:42:22.39,0:42:23.28,优酷剧集英语,,0,0,0,,怎么又来了
Dialogue: 0,0:42:23.71,0:42:24.87,优酷剧集英语,,0,0,0,,没完没了了还
Dialogue: 0,0:42:25.15,0:42:26.67,优酷剧集英语,,0,0,0,,你必须再发表一篇文章
Dialogue: 0,0:42:26.67,0:42:27.56,优酷剧集英语,,0,0,0,,帮我声明
Dialogue: 0,0:42:27.87,0:42:28.67,优酷剧集英语,,0,0,0,,就改你这俩字 我
Dialogue: 0,0:42:28.67,0:42:30.43,优酷剧集英语,,0,0,0,,掌柜的掌柜的
Dialogue: 0,0:42:30.43,0:42:31.32,优酷剧集英语,,0,0,0,,有妖怪
Dialogue: 0,0:42:31.76,0:42:32.95,优酷剧集英语,,0,0,0,,慌什么 慢慢说
Dialogue: 0,0:42:32.95,0:42:34.63,优酷剧集英语,,0,0,0,,这杨楼街又闹帽妖了
Dialogue: 0,0:42:34.63,0:42:36.43,优酷剧集英语,,0,0,0,,五年前的传闻是真的
Dialogue: 0,0:42:36.43,0:42:37.47,优酷剧集英语,,0,0,0,,馒头店的武大
Dialogue: 0,0:42:37.60,0:42:38.80,优酷剧集英语,,0,0,0,,被帽妖吃了头皮
Dialogue: 0,0:42:38.87,0:42:39.71,优酷剧集英语,,0,0,0,,吸了魂魄
Dialogue: 0,0:42:40.23,0:42:41.32,优酷剧集英语,,0,0,0,,给死了
Dialogue: 0,0:42:41.87,0:42:43.00,优酷剧集英语,,0,0,0,,还有个跑腿的叫
Dialogue: 0,0:42:43.32,0:42:44.52,优酷剧集英语,,0,0,0,,叫勃哥
Dialogue: 0,0:42:44.91,0:42:46.15,优酷剧集英语,,0,0,0,,听说他是嫌犯
Dialogue: 0,0:42:46.67,0:42:49.04,优酷剧集英语,,0,0,0,,也不知道他跟这帽妖是什么关系
Dialogue: 0,0:42:49.04,0:42:50.76,优酷剧集英语,,0,0,0,,你 你说那个嫌犯叫什么
Dialogue: 0,0:42:51.28,0:42:51.95,优酷剧集英语,,0,0,0,,勃哥呀
Dialogue: 0,0:42:51.95,0:42:52.67,优酷剧集英语,,0,0,0,,你认识啊
Dialogue: 0,0:42:56.47,0:42:56.87,优酷剧集英语,,0,0,0,,墨兄
Dialogue: 0,0:42:56.87,0:42:57.39,优酷剧集英语,,0,0,0,,回头聊
Dialogue: 0,0:42:57.47,0:42:58.00,优酷剧集英语,,0,0,0,,我
Dialogue: 0,0:42:58.15,0:42:58.67,优酷剧集英语,,0,0,0,,墨兄
Dialogue: 0,0:43:07.36,0:43:10.47,优酷剧集英语,,0,0,0,,宋朝居然也有房地产中介小哥
Dialogue: 0,0:43:11.12,0:43:11.95,优酷剧集英语,,0,0,0,,在宋朝
Dialogue: 0,0:43:12.15,0:43:14.39,优酷剧集英语,,0,0,0,,提供房地产交易服务的人
Dialogue: 0,0:43:14.39,0:43:15.56,优酷剧集英语,,0,0,0,,被称为房牙
Dialogue: 0,0:43:15.76,0:43:18.15,优酷剧集英语,,0,0,0,,兼有促成交易 查议价格
Dialogue: 0,0:43:18.15,0:43:20.15,优酷剧集英语,,0,0,0,,充当担保等多项职能
Dialogue: 0,0:43:20.95,0:43:22.28,优酷剧集英语,,0,0,0,,他们身前会挂上
Dialogue: 0,0:43:22.39,0:43:24.08,优酷剧集英语,,0,0,0,,官府颁发的牙牌
Dialogue: 0,0:43:24.23,0:43:26.52,优酷剧集英语,,0,0,0,,工作证上会有牙人的名字
Dialogue: 0,0:43:26.52,0:43:28.80,优酷剧集英语,,0,0,0,,和对牙人基本的条例约束
Dialogue: 0,0:43:28.80,0:43:31.91,优酷剧集英语,,0,0,0,,所以如果交易中出现欺诈行为
Dialogue: 0,0:43:32.04,0:43:34.28,优酷剧集英语,,0,0,0,,房牙也需承担担保责任
Dialogue: 0,0:43:34.67,0:43:36.04,优酷剧集英语,,0,0,0,,出事会被连坐
Dialogue: 0,0:43:36.28,0:43:38.63,优酷剧集英语,,0,0,0,,宋朝买房对比当今如何
Dialogue: 0,0:43:39.00,0:43:40.80,优酷剧集英语,,0,0,0,,买一套属于自己的房
Dialogue: 0,0:43:41.39,0:43:43.12,优酷剧集英语,,0,0,0,,就连当官的都要考虑
Dialogue: 0,0:43:43.12,0:43:44.63,优酷剧集英语,,0,0,0,,是不是有这个实力
Dialogue: 0,0:43:45.91,0:43:46.80,优酷剧集英语,,0,0,0,,咱就是说
Dialogue: 0,0:43:46.80,0:43:47.60,优酷剧集英语,,0,0,0,,有没有人
Dialogue: 0,0:43:47.60,0:43:49.76,优酷剧集英语,,0,0,0,,想穿到房地产火爆的宋朝
Dialogue: 0,0:43:49.84,0:43:51.43,优酷剧集英语,,0,0,0,,当一回房牙小哥呢

