Dialogue: 0,0:05:42.56,0:05:43.40,优酷22号字体,,0,0,0,,坚持住
Dialogue: 0,0:06:03.52,0:06:04.32,优酷22号字体,,0,0,0,,云深
Dialogue: 0,0:06:35.60,0:06:37.36,优酷22号字体,,0,0,0,,朱医生你挺住啊 朱医生
Dialogue: 0,0:06:39.00,0:06:40.44,优酷22号字体,,0,0,0,,云深 朱医生 云深
Dialogue: 0,0:06:46.32,0:06:48.24,优酷22号字体,,0,0,0,,云深 云深
Dialogue: 0,0:06:50.16,0:06:50.60,优酷22号字体,,0,0,0,,云深
Dialogue: 0,0:07:22.68,0:07:23.80,优酷22号字体,,0,0,0,,你放开她
Dialogue: 0,0:07:24.16,0:07:25.12,优酷22号字体,,0,0,0,,你放开她
Dialogue: 0,0:07:25.76,0:07:27.04,优酷22号字体,,0,0,0,,你放开她
Dialogue: 0,0:07:27.44,0:07:28.04,优酷22号字体,,0,0,0,,朱旧
Dialogue: 0,0:07:29.44,0:07:30.20,优酷22号字体,,0,0,0,,朱旧
Dialogue: 0,0:07:30.76,0:07:31.24,优酷22号字体,,0,0,0,,朱旧
